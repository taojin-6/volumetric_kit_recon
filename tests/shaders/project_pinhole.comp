#version 450

// Runs tsdf_common.glsl's project_to_image (project_pinhole under it) over
// cases the host writes, so the host test sees which projections it accepts.
// Invocation i handles case i: accepted[i] is 1 when the case projects, and
// pixels[i] is then its pixel, else (-1, -1).

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

#include "volumetric_kit/recon/tsdf/shaders/tsdf_common.glsl"

layout(local_size_x = 64) in;

struct Case {
  DepthCameraParams cam;
  vec3 world;
};

layout(set = 0, binding = 0, scalar) readonly buffer Cases {
  Case cases[];
};
layout(set = 0, binding = 1, scalar) writeonly buffer Accepted {
  uint accepted[];
};
layout(set = 0, binding = 2, scalar) writeonly buffer Pixels {
  vec2 pixels[];
};

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(cases.length())) {
    return;
  }
  vec2 px;
  float zc;
  bool ok = project_to_image(cases[i].cam, cases[i].world, px, zc);
  accepted[i] = ok ? 1u : 0u;
  pixels[i] = ok ? px : vec2(-1.0);
}
