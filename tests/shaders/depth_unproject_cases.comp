#version 450

// Runs volume's vrUnprojectDepth (volume/shaders/depth_pinhole.glsl) and
// core/shaders/pinhole.glsl's vr_unproject_pinhole over the cases the host
// writes: invocation i unprojects case i's pixel at its depth through its
// camera with both, into volume_point[i].xyz and core_point[i].xyz.

#extension GL_GOOGLE_include_directive : require

#include "volumetric_kit/recon/core/shaders/pinhole.glsl"
#include "volumetric_kit/recon/volume/shaders/depth_pinhole.glsl"

layout(local_size_x = 64) in;

struct Case {
  vec4 k;       // fx, fy, cx, cy
  vec2 pixel;   // the pixel to unproject
  float depth;  // along +Z, metres
  float pad;
};

layout(set = 0, binding = 0, std430) readonly buffer Cases {
  Case cases[];
};
layout(set = 0, binding = 1, std430) writeonly buffer VolumePoints {
  vec4 volume_point[];
};
layout(set = 0, binding = 2, std430) writeonly buffer CorePoints {
  vec4 core_point[];
};

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(cases.length())) {
    return;
  }
  Case c = cases[i];
  volume_point[i] = vec4(vrUnprojectDepth(c.pixel, c.depth, c.k), 0.0);
  core_point[i] = vec4(vr_unproject_pinhole(c.pixel, c.depth, c.k), 0.0);
}
