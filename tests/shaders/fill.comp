#version 450

// Compute smoke shader: write each element's global invocation index into a
// storage buffer. The minimal kernel that proves recon can build a compute
// pipeline, bind an SSBO + push constants, dispatch through the platform driver
// (MoltenVK on Apple), and hand back a result the host can verify.
//
// A flat uint array needs no scalar block layout -- std430 and scalar agree for
// uint (the scalar-layout ABI matters only for the vec3-bearing hash structs,
// proven when the volume tier lands). Targeted at Vulkan 1.2 (see
// cmake/vr_shaders.cmake).

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) writeonly buffer Output { uint values[]; };

layout(push_constant) uniform Push { uint count; };

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < count) {
    values[i] = i;
  }
}
