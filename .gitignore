# Build directories
/build*/
/cmake-build-*/
/out/

# Local git worktrees (one per in-flight change; see CLAUDE.md)
/.worktrees/

# CMake / user state
CMakeUserPresets.json
.cache/
compile_commands.json

# Compiled GPU shader intermediates (built into the build tree)
*.air
*.metallib
*.ptx
*.cubin
*.fatbin

# Rendered / captured artifacts from examples and tests
*.ppm
*.png.actual
*.obj.actual
*.glb.actual

# Test asset fixtures fetched at configure time, not committed
/tests/assets/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# GPU debugging captures (Xcode Metal frame capture / Nsight)
*.gputrace
*.nsys-rep
*.ncu-rep

# Xcode-generator output (Apple/Metal builds)
*.xcodeproj/
DerivedData/

# Logs
*.log
