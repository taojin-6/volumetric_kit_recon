#pragma once

/// @file version.hpp
/// @brief Compile-time and runtime accessors for the library version. Generated
///        from version.hpp.in by CMake -- do not edit the generated copy.

#include "volumetric_kit/grid/base/export.hpp"

#define VGRID_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define VGRID_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define VGRID_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define VGRID_VERSION_STRING "@PROJECT_VERSION@"

namespace volumetric_kit::grid {

/// @return The library version as "MAJOR.MINOR.PATCH".
VGRID_BASE_API const char* version_string() noexcept;

/// @return The major version component.
VGRID_BASE_API int version_major() noexcept;
/// @return The minor version component.
VGRID_BASE_API int version_minor() noexcept;
/// @return The patch version component.
VGRID_BASE_API int version_patch() noexcept;

}  // namespace volumetric_kit::grid
