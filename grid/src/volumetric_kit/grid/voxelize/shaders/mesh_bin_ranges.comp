#version 450
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 256) in;
struct MeshBin { int ptr; uint begin; uint count; };
layout(scalar, binding = 0) readonly buffer Blocks { MeshBin blocks[]; };
layout(scalar, binding = 1) readonly buffer Total { uvec4 total; };
layout(scalar, binding = 2) writeonly buffer Ranges { uvec2 ranges[]; };
layout(push_constant, scalar) uniform Push {
  uint size; uint capacity; uint window; uint max_bin;
} pc;
uint lowerBound(uint entry) {
  uint lo = 0u, hi = total.y;
  while (lo < hi) {
    uint mid = lo + (hi - lo) / 2u;
    if (blocks[mid].begin < entry) lo = mid + 1u;
    else hi = mid;
  }
  return lo;
}
void main() {
  uint r = gl_GlobalInvocationID.x;
  if (r >= pc.size) return;
  ranges[r] = uvec2(0u);
  if (total.y > pc.capacity || total.z > pc.max_bin || total.w != 0u) return;
  uint start = r * pc.window;
  if (start >= total.x) return;
  // Avoid overflowing near UINT32_MAX. Consecutive bin starts in this window
  // span at most window-1 entries, plus at most max_bin for the last bin.
  uint end = start + min(pc.window, total.x - start);
  uint first = lowerBound(start);
  ranges[r] = uvec2(first, lowerBound(end) - first);
}
