// The deblock's first dispatch (deblock.hpp): the per-block fallback's flags.
// An invocation a frame block, kLanes a workgroup, the entry item_base + the
// global invocation id: a block whose mask is all ones finds its slot by
// coordinate through the grid's hash and sets full[slot], which the batch
// zeroed; a masked block, which keeps its exact decode, probes nothing and is
// counted, a workgroup's count added to exact_blocks at once. No invocation
// reads a flag another writes; the dispatches after this one read them,
// after the batch's barrier.

#extension GL_GOOGLE_include_directive : require
#include "deblock_common.glsl"

layout(local_size_x = kLanes) in;

shared uint s_masked;

void main() {
  uint lane = gl_LocalInvocationIndex;
  uint entry = pc.item_base + gl_GlobalInvocationID.x;
  if (lane == 0u) {
    s_masked = 0u;
  }
  barrier();
  if (entry < pc.num_blocks) {
    if (vrEntryFull(entry)) {
      int ptr = vrFindBlockPtr(blocks[entry].coord, pc.num_buckets,
                               pc.bucket_size, pc.max_chain);
      if (ptr >= 0) {
        full[uint(ptr) / kBlockVoxels] = 1u;
      }
    } else {
      atomicAdd(s_masked, 1u);
    }
  }
  barrier();
  if (lane == 0u && s_masked != 0u) {
    atomicAdd(exact_blocks, s_masked);
  }
}
