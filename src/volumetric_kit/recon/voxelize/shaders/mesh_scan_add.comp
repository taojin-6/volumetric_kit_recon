#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 256) in;
layout(scalar, binding = 0) buffer Values { uvec4 values[]; };
layout(scalar, binding = 1) readonly buffer Groups { uvec4 groups[]; };
layout(push_constant, scalar) uniform Push { uint size; uint first_group; } pc;
#include "mesh_scan.glsl"
void main() {
  uint item = (pc.first_group + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x;
  if (item < pc.size) values[item] = meshCombine(groups[item / 256u], values[item]);
}
