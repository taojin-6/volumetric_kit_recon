// The device frame's step layout (step_layout.hpp), one workgroup on
// scan.glsl. First each entry's first step, starts[p]: the steps of the
// entries before it in stream order, an exclusive scan, with their total at
// starts[N]. Then each segment's output slot, in 16-bit words: a word a step
// and the final state's two, rounded up to whole 32-bit words so no two
// segments share one, scanned into slot_offsets, with their total at [S].
// The second scan reads the first's starts at the segments' ends, which
// other lanes wrote, hence the coherent buffer and the barrier between. Each
// lane sums kRun values in a row before a chunk's scan and places them after
// it, so a chunk covers 2,048 values: room0's 21,771 entries take 11 chunks'
// barrier rounds, not 86.
//
// The step total stops at the first value whose steps reach 4 GiB, 4 bytes
// each, which the writer refuses. Below it every value is exact: the slot
// words stay below 2^32, since a slot holds its steps and at most three words
// more, and a frame has fewer than 2^30 segments; past it, the entries' bound
// (step_layout.hpp) keeps a chunk's sum from wrapping.

#version 450
#extension GL_GOOGLE_include_directive : require

#include "frame_models.glsl"
#include "rans_push.glsl"
#include "scan.glsl"

layout(local_size_x = kScanLanes) in;

layout(set = 0, binding = 0, std430) readonly buffer Steps {
  uint steps[];  // N, each entry's coder steps
};
layout(set = 0, binding = 1, std430) coherent buffer Starts {
  uint starts[];  // N + 1
};
layout(set = 0, binding = 2, std430) writeonly buffer SlotOffsets {
  uint slot_offsets[];  // in 16-bit words, segment_count + 1, each even
};

const uint kStepCap = 1u << 30u;
const uint kRun = 8u;  // a chunk spans kScanLanes * kRun values

void main() {
  const uint lane = gl_LocalInvocationID.x;
  const uint n = pc.num_entries;
  uint carry = 0u;
  for (uint base = 0u; base < n; base += kScanLanes * kRun) {
    const uint first = base + lane * kRun;
    uint run[kRun];
    uint sum = 0u;
    for (uint i = 0u; i < kRun; ++i) {
      run[i] = first + i < n ? steps[first + i] : 0u;
      sum += run[i];
    }
    uint at = vrScanChunk(sum, carry);
    carry = min(carry, kStepCap);
    for (uint i = 0u; i < kRun && first + i < n; ++i) {
      starts[first + i] = at;
      at += run[i];
    }
  }
  if (lane == 0u) starts[n] = carry;
  memoryBarrierBuffer();
  barrier();

  const uint m = pc.reference_count;
  const uint segments = pc.segment_count;
  carry = 0u;
  for (uint base = 0u; base < segments; base += kScanLanes * kRun) {
    const uint first = base + lane * kRun;
    uint run[kRun];
    uint sum = 0u;
    for (uint i = 0u; i < kRun; ++i) {
      run[i] = 0u;
      if (first + i < segments) {
        const uvec2 range = segment_range(first + i, m, pc.update_size, n - m,
                                          pc.segment_size);
        run[i] = (starts[range.y] - starts[range.x] + 3u) & ~1u;
      }
      sum += run[i];
    }
    uint at = vrScanChunk(sum, carry);
    for (uint i = 0u; i < kRun && first + i < segments; ++i) {
      slot_offsets[first + i] = at;
      at += run[i];
    }
  }
  if (lane == 0u) slot_offsets[segments] = carry;
}
