// Forward block DCT: for each listed block, divide its observed SDF by
// trunc_dist, fill its unobserved voxels from the observed ones, take the
// orthonormal 8^3 DCT-II, and write the first K coefficients in zigzag order,
// each rounded half-to-even after dividing by its step and clamped to +-32767
// (CodecParams::validate keeps the step coarse enough that the clamp never
// engages on in-range input). Also pack the observed mask: bit v % 32 of word
// v / 32 is set where voxel v's weight >= observed_weight.
//
// Re-implements the prior engine's computeDCTKernel (compute_dct.cu) with one
// lane per line instead of one thread per voxel -- see dct_common.glsl. Output
// is indexed by list position, not by block ptr.

#extension GL_GOOGLE_include_directive : require
#include "dct_common.glsl"

layout(local_size_x = kLanes) in;

layout(set = 0, binding = VR_DCT_BINDING_TSDF, scalar) readonly buffer Tsdf {
  float tsdf[];
};
layout(set = 0, binding = VR_DCT_BINDING_WEIGHT, scalar) readonly buffer
    Weight {
  float weight[];
};
layout(set = 0, binding = VR_DCT_BINDING_COEFFICIENTS, scalar) writeonly buffer
    Coefficients {
  int coefficients[];
};
layout(set = 0, binding = VR_DCT_BINDING_MASKS, scalar) writeonly buffer
    Masks {
  uint masks[];
};

shared uint s_mask[kMaskWords];
// Per voxel, whether s_work holds a value for it yet: observed, or filled.
shared uint s_known[kBlockVoxels];

// Give each unknown voxel of one line the value of the nearest voxel that was
// known when the pass began, the lower index on a tie. A line with nothing
// known is left for a later pass. Only this lane's line is read or written.
void fill_line(uint base, uint stride) {
  float val[kEdge];
  uint known = 0u;
  for (uint i = 0u; i < kEdge; ++i) {
    val[i] = s_work[base + i * stride];
    if (s_known[base + i * stride] != 0u) {
      known |= 1u << i;
    }
  }
  if (known == 0u || known == kLineBits) {
    return;
  }
  for (uint i = 0u; i < kEdge; ++i) {
    if (((known >> i) & 1u) != 0u) {
      continue;
    }
    for (uint d = 1u; d < kEdge; ++d) {
      if (i >= d && ((known >> (i - d)) & 1u) != 0u) {
        s_work[base + i * stride] = val[i - d];
        break;
      }
      if (i + d < kEdge && ((known >> (i + d)) & 1u) != 0u) {
        s_work[base + i * stride] = val[i + d];
        break;
      }
    }
    s_known[base + i * stride] = 1u;
  }
}

// Fill the unobserved voxels along x, then y, then z, on the lane-to-line
// mapping the transform uses. After the three passes every voxel is known
// unless the block has no observed voxel at all, and those stay at the 0 they
// were loaded as. The decoder masks these voxels out whatever they hold, so the
// fill is free to choose them, and a smooth continuation of the observed field
// is what a truncated DCT keeps best: a fused block's unobserved voxels read 0,
// the iso level, and the step from there to the observed band is what K = 32
// could not represent -- that leaked 2-5x the error into the observed voxels
// beside the mask edge. The rule is in DECISIONS.md (2026-09-26).
void fill_unobserved(uint lane) {
  fill_line(x_line_base(lane), kStrideX);
  barrier();
  fill_line(y_line_base(lane), kStrideY);
  barrier();
  fill_line(z_line_base(lane), kStrideZ);
  barrier();
}

void main() {
  uint lane = gl_LocalInvocationIndex;
  uint entry = pc.block_base + gl_WorkGroupID.x;
  // Uniform across the workgroup (it depends only on the group id), so every
  // barrier below is still reached by all of this group's lanes or none.
  if (entry >= pc.num_blocks || !block_is_live(entry, lane)) {
    return;
  }
  uint voxel_base = uint(blocks[entry].ptr);

  s_basis[lane] = basis[lane];
  if (lane < kMaskWords) {
    s_mask[lane] = 0u;
  }

  // Load this lane's x-line and note which of its voxels were observed. An
  // unobserved voxel's tsdf is never read, so the coefficients depend on the
  // observed voxels alone.
  float inv_trunc = 1.0 / pc.trunc_dist;
  uint line_bits = 0u;
  for (uint x = 0u; x < kEdge; ++x) {
    uint v = x_line_base(lane) + x;
    bool obs = weight[voxel_base + v] >= pc.observed_weight;
    s_work[v] = obs ? tsdf[voxel_base + v] * inv_trunc : 0.0;
    s_known[v] = obs ? 1u : 0u;
    if (obs) {
      line_bits |= 1u << x;
    }
  }
  barrier();

  // A line is kEdge bits and a word holds kLinesPerMaskWord lines: lane r's
  // bits land at bit (r % kLinesPerMaskWord) * kEdge of word
  // r / kLinesPerMaskWord, which is bit v % kMaskWordBits of word
  // v / kMaskWordBits for each of its voxels v = kEdge r + x.
  atomicOr(s_mask[lane / kLinesPerMaskWord],
           line_bits << ((lane % kLinesPerMaskWord) * kEdge));

  fill_unobserved(lane);
  transform_cube(lane, false);

  uint k = pc.coefficient_count;
  for (uint j = lane; j < k; j += kLanes) {
    float q = roundEven(s_work[kHalf + zigzag[j]] / step_for(j));
    float bound = float(pc.max_quantized);
    coefficients[entry * k + j] = int(clamp(q, -bound, bound));
  }
  if (lane < kMaskWords) {
    masks[entry * kMaskWords + lane] = s_mask[lane];
  }
}
