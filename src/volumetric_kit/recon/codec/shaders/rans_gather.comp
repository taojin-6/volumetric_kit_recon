// Pack every segment's stream into one payload: each invocation writes a
// 32-bit word at a time, finding the segment each of its two 16-bit halves
// came from. Streams are 16-bit aligned, so no word is written twice.
// rans_scan.comp sizes the dispatch from the payload, so no invocation starts
// past it; a payload past the group cap loops.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 256) in;

#include "rans_push.glsl"

layout(set = 0, binding = 0, std430) readonly buffer SlotOffsets {
  uint slot_offsets[];  // in 16-bit words, segment_count + 1
};
layout(set = 0, binding = 1, std430) readonly buffer Slots {
  uint slots[];
};
layout(set = 0, binding = 2, std430) readonly buffer Lengths {
  uint lengths[];
};
layout(set = 0, binding = 3, std430) readonly buffer PayloadOffsets {
  uint payload_offsets[];  // bytes, segment_count + 1
};
layout(set = 0, binding = 4, std430) writeonly buffer Payload {
  uint payload[];
};

// The payload's 16-bit word q, from the segment whose stream holds it.
uint payload16(uint q) {
  const uint at = 2u * q;
  uint lo = 0u;  // payload_offsets[lo] <= at < payload_offsets[hi]
  uint hi = pc.segment_count;
  while (hi - lo > 1u) {
    const uint mid = (lo + hi) / 2u;
    if (payload_offsets[mid] <= at) {
      lo = mid;
    } else {
      hi = mid;
    }
  }
  const uint begin = slot_offsets[lo + 1u] - lengths[lo] / 2u;
  const uint src = begin + (at - payload_offsets[lo]) / 2u;
  return (slots[src >> 1u] >> (16u * (src & 1u))) & 0xFFFFu;
}

void main() {
  const uint total = payload_offsets[pc.segment_count];
  const uint words = (total + 3u) / 4u;
  const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  for (uint w = gl_GlobalInvocationID.x; w < words; w += stride) {
    const uint low = payload16(2u * w);
    const uint high = 4u * w + 2u < total ? payload16(2u * w + 1u) : 0u;
    payload[w] = low | (high << 16u);
  }
}
