// The device frame's decode: one invocation per segment runs rans.hpp's
// RansReader, with the same 32-bit integer arithmetic, under
// frame_grammar.glsl's reader half over the segment's stream, and writes each
// block's coordinate, mask and coefficients where the inverse transform reads
// them. The host reader is the reference: the same frame decodes to the same
// blocks, and a segment fails here exactly when it fails there, which the
// device frame test checks.

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

#define VR_HASH_COMMON_NO_PUSH_CONSTANTS
#include "volumetric_kit/recon/volume/shaders/hash_common.glsl"

#include "rans_push.glsl"

#define VR_FRAME_READER
#include "frame_grammar.glsl"

layout(set = 0, binding = 0, std430) readonly buffer Slots {
  uint slots[];  // rans_slots.comp's, 4096 a model
};
layout(set = 0, binding = 1, std430) readonly buffer Payload {
  uint payload[];  // the segment streams, little-endian 16-bit words
};
layout(set = 0, binding = 2, std430) readonly buffer SegmentWords {
  uint segment_words[];  // each segment's first word, segment_count + 1
};
layout(set = 0, binding = 3, scalar) writeonly buffer Blocks {
  BlockIndex blocks[];  // coord, ptr 0
};
layout(set = 0, binding = 4, std430) writeonly buffer Masks {
  uint masks[];  // kMaskWords a block
};
layout(set = 0, binding = 5, std430) writeonly buffer Coefficients {
  uint coefficients[];  // two int16 a word, (K + 1) / 2 words a block
};
layout(set = 0, binding = 6, std430) writeonly buffer Faults {
  uint faults[];  // a SegmentFault per segment
};

const uint kRansLower = 1u << 16u;
const uint kFaultNone = 0u;
const uint kFaultCoordOverflow = 1u;
const uint kFaultCorrupt = 2u;

// RansReader's state: sticky failure, as there.
uint g_x = 0u;
uint g_pos = 0u;  // the next word
uint g_end = 0u;  // one past the segment's last word
bool g_failed = false;

uint word_at(uint q) { return (payload[q >> 1u] >> (16u * (q & 1u))) & 0xFFFFu; }

void renormalize() {
  if (g_x < kRansLower) {
    if (g_pos >= g_end) {
      g_failed = true;
      return;
    }
    g_x = (g_x << 16u) | word_at(g_pos);
    g_pos += 1u;
  }
}

uint get(uint model) {
  if (g_failed) return 0u;
  const uint slot = g_x & 4095u;
  const uint entry = slots[(model << 12u) + slot];
  const uint freq = ((entry >> 8u) & 0xFFFu) + 1u;
  const uint offset = entry >> 20u;
  if (offset >= freq) {  // an empty table
    g_failed = true;
    return 0u;
  }
  g_x = freq * (g_x >> 12u) + offset;
  renormalize();
  return g_failed ? 0u : (entry & 0xFFu);
}

uint get_bits(uint bits) {
  uint value = 0u;
  uint shift_out = 0u;
  while (bits > 0u && !g_failed) {
    const uint n = min(bits, 12u);
    const uint shift = 12u - n;
    const uint slot = g_x & 4095u;
    const uint chunk = slot >> shift;
    g_x = ((g_x >> 12u) << shift) + slot - (chunk << shift);
    renormalize();
    value |= chunk << shift_out;
    shift_out += n;
    bits -= n;
  }
  return g_failed ? 0u : value;
}

bool coder_failed() { return g_failed; }

uint g_coefficients = 0u;  // the block's first word
uint g_low = 0u;           // an even coefficient, waiting for the odd one

// Two coefficients a word, low first.
void store_coefficient(uint j, int value) {
  const uint v = uint(value) & 0xFFFFu;
  if ((j & 1u) == 0u) {
    g_low = v;
  } else {
    coefficients[g_coefficients + j / 2u] = g_low | (v << 16u);
  }
}

void main() {
  const uint s = pc.item_base + gl_GlobalInvocationID.x;
  if (s >= pc.segment_count) return;
  const uint begin = segment_words[s];
  g_end = segment_words[s + 1u];
  // The parser checked every length is even and at least 4 bytes.
  g_x = (word_at(begin) << 16u) | word_at(begin + 1u);
  g_pos = begin + 2u;
  g_failed = g_x < kRansLower;

  const uint first = s * pc.segment_size;  // < num_blocks
  const uint end = pc.num_blocks - first > pc.segment_size
                       ? first + pc.segment_size
                       : pc.num_blocks;
  const uint k = pc.coefficient_count;
  uint fault = kFaultNone;
  g_coord = ivec3(0);
  for (uint i = first; i < end && !g_failed; ++i) {
    g_coefficients = i * ((k + 1u) / 2u);
    if (!read_block(i == first, k)) {
      fault = kFaultCoordOverflow;
      break;
    }
    blocks[i].coord = g_coord;
    blocks[i].ptr = 0;
    for (uint w = 0u; w < kMaskWords; ++w) {
      masks[i * kMaskWords + w] = g_mask[w];
    }
    // An odd K's last word, its pad zero.
    if ((k & 1u) != 0u) coefficients[g_coefficients + k / 2u] = g_low;
  }
  if (fault == kFaultNone &&
      (g_failed || g_pos != g_end || g_x != kRansLower)) {
    fault = kFaultCorrupt;
  }
  faults[s] = fault;
}
