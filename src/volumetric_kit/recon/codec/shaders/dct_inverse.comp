// Inverse block DCT: for each listed block, dequantize its K zigzag-ordered
// coefficients into an otherwise-zero cube, inverse-transform, and write the
// block back. An observed voxel (its mask bit set) gets the reconstructed SDF,
// scaled by trunc_dist and clamped to +-trunc_dist -- the range the integrator
// keeps, which ringing from the dropped coefficients can overshoot -- and the
// decoded weight. An unobserved voxel gets zero tsdf and zero weight, exactly
// what a freshly allocated block holds, so the mesher skips it as it skipped
// the original. A block whose tsdf or weight this leaves different is stamped
// changed with the map's tick, as the integrator stamps one, so a frame that
// repeats a block's last one leaves it unstamped. An entry
// whose coord the table does not hold (see block_ptr) is written nothing.
//
// Re-implements the prior engine's computeIDCTKernel (compute_dct.cu), which
// wrote every voxel's SDF and left weights alone; the mask is what replaces the
// weights it did not have to send.

#extension GL_GOOGLE_include_directive : require
#include "dct_common.glsl"
#include "volumetric_kit/recon/volume/shaders/block_stamp.glsl"

layout(local_size_x = kLanes) in;

layout(set = 0, binding = VR_DCT_BINDING_TSDF, scalar) buffer Tsdf {
  float tsdf[];
};
layout(set = 0, binding = VR_DCT_BINDING_WEIGHT, scalar) buffer Weight {
  float weight[];
};
layout(set = 0, binding = VR_DCT_BINDING_COEFFICIENTS, scalar) readonly buffer
    Coefficients {
  uint coefficients[];
};
layout(set = 0, binding = VR_DCT_BINDING_MASKS, scalar) readonly buffer
    Masks {
  uint masks[];
};
layout(set = 0, binding = VR_DCT_BINDING_STAMPS, scalar) buffer Stamps {
  BlockStamp stamps[];
};

shared uint s_changed;

void main() {
  uint lane = gl_LocalInvocationIndex;
  uint entry = pc.block_base + gl_WorkGroupID.x;
  // Uniform across the workgroup; see dct_forward.comp.
  if (entry >= pc.num_blocks) {
    return;
  }
  int ptr = block_ptr(entry, lane);
  if (ptr < 0) {
    return;
  }
  uint voxel_base = uint(ptr);
  if (lane == 0u) {
    s_changed = 0u;
  }

  s_basis[lane] = basis[lane];
  for (uint x = 0u; x < kEdge; ++x) {
    s_work[x_line_base(lane) + x] = 0.0;
  }
  barrier();

  // Scatter the kept coefficients to their zigzag positions; the rest stay 0.
  uint k = pc.coefficient_count;
  uint words = coefficient_words();
  for (uint j = lane; j < k; j += kLanes) {
    uint word = coefficients[entry * words + j / 2u];
    int q = bitfieldExtract(int(word), int(16u * (j % 2u)), 16);
    s_work[zigzag[j]] = float(q) * step_for(j);
  }
  barrier();

  transform_cube(lane, true);

  // Write back this lane's x-line, gated by its 8 mask bits.
  uint line_bits =
      (masks[entry * kMaskWords + lane / kLinesPerMaskWord] >>
       ((lane % kLinesPerMaskWord) * kEdge)) &
      kLineBits;
  bool changed = false;
  for (uint x = 0u; x < kEdge; ++x) {
    uint local = x_line_base(lane) + x;
    uint v = voxel_base + local;
    bool observed = ((line_bits >> x) & 1u) != 0u;
    float sdf = clamp(s_work[kHalf + local], -1.0, 1.0) * pc.trunc_dist;
    float t = observed ? sdf : 0.0;
    float w = observed ? pc.decoded_weight : 0.0;
    changed = changed || tsdf[v] != t || weight[v] != w;
    tsdf[v] = t;
    weight[v] = w;
  }
  if (changed) {
    atomicOr(s_changed, 1u);
  }
  barrier();
  if (lane == 0u && s_changed != 0u) {
    stamps[voxel_base / kBlockVoxels].changed = pc.tick;
  }
}
