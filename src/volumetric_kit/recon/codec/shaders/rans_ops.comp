// The device frame's coder steps: one invocation per entry walks its symbols
// in the order the grammar emits them and writes each one's steps, as
// `start | freq << 16` words, downward from the end of the entry's run. The
// encoder takes steps last first, and the host lays each segment's entries
// last first, so a segment's steps are one run in the encoder's order that
// rans_encode.comp streams through: the branchy symbol walk runs here, an
// entry per invocation, and only the rANS state's chain stays serial.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "rans_walk.glsl"

// Bindings 0-3 are the walk's.
layout(set = 0, binding = 4, std430) readonly buffer Tables {
  uint tables[];  // per model, per symbol, at model_base: cum | freq << 16
};
layout(set = 0, binding = 5, std430) readonly buffer StepEnds {
  uint step_ends[];  // per entry: one past its run's last step
};
layout(set = 0, binding = 6, std430) writeonly buffer Steps {
  uint steps[];
};

const uint kScaleBits = 12u;

uint g_at = 0u;  // the step written last: the next goes below it

void sink_symbol(uint model, uint symbol) {
  steps[--g_at] = tables[model_base(model, pc.coefficient_count) + symbol];
}

// A raw field's steps (rans.hpp): chunks of at most 12 bits, low first.
void sink_bits(uint value, uint bits) {
  for (uint low = 0u; low < bits; low += 12u) {
    const uint n = min(bits - low, 12u);
    const uint chunk = (value >> low) & ((1u << n) - 1u);
    const uint shift = kScaleBits - n;
    steps[--g_at] = (chunk << shift) | ((1u << shift) << 16u);
  }
}

void main() {
  const uint p = pc.item_base + gl_GlobalInvocationID.x;
  if (p >= pc.num_entries) return;
  g_at = step_ends[p];
  walk_entry(p);
}
