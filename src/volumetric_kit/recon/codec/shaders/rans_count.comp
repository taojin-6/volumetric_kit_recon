// The device frame's pass 1: every model's symbol counts, each entry's coder
// steps, which rans_layout.comp lays out, and what check_entries refuses
// (bitstream.hpp). One invocation per position of num_entries, which a
// bounded P-frame's surplus takes the survivors off (counted_entries): a
// position past the frame's returns.

#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 64) in;

#include "rans_walk.glsl"

// Bindings 0-3 are the walk's.
layout(set = 0, binding = 4, std430) buffer Counts {
  uint counts[];  // per model, per symbol, at model_base, a P-frame's layout
};
layout(set = 0, binding = 5, std430) writeonly buffer Steps {
  uint steps[];  // per entry
};
layout(set = 0, binding = 6, std430) buffer Refusal {
  uint largest_mode;  // the largest mode past the alphabet, else 0
  uint out_of_range;  // nonzero when a written value is -32768
};
layout(set = 0, binding = 7, std430) readonly buffer Surplus {
  uint surplus;  // the entries past the frame's (counted_entries)
};

uint g_steps = 0u;

void sink_symbol(uint model, uint symbol) {
  atomicAdd(counts[model_base(model, pc.coefficient_count) + symbol], 1u);
  g_steps += 1u;
}

void sink_bits(uint value, uint bits) { g_steps += (bits + 11u) / 12u; }

void main() {
  const uint p = pc.item_base + gl_GlobalInvocationID.x;
  if (p >= counted_entries(surplus)) return;
  walk_entry(p);
  steps[p] = g_steps;
  if (g_bad_mode != 0u) atomicMax(largest_mode, g_bad_mode);
  if (g_out_of_range) atomicOr(out_of_range, 1u);
}
