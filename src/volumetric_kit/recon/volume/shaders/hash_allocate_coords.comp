#version 450

// Allocate voxel blocks at the given block coordinates. Each thread takes one
// input coord and inserts it if absent, through the shared allocate_block
// machinery (hash_allocate_common.glsl): a lock-free existence check, then a
// bucket-locked insert into the primary bucket or, when it is full, the
// collision overflow chain, drawing a free block from the heap. Failed
// allocations bump fail_count by reason so the host can grow the table + retry.

#extension GL_GOOGLE_include_directive : require
#include "hash_common.glsl"
#include "hash_allocate_common.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 4, scalar) readonly buffer Coords {
  BlockIndex coords[];
};

void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= pc.arg) {  // pc.arg = input coord count
    return;
  }
  report_alloc_fail(allocate_block(coords[gid].coord));
}
