#version 450

// Compact the active blocks that intersect any of n camera frusta: scan every
// hash entry, and for each occupied one whose world-space block AABB is not
// fully outside any of some frustum's six planes, append its (coord, ptr) to a
// contiguous output array via an atomic bump counter. One scan for the union,
// so a block several frusta keep is listed once. `pc.arg` is the output
// capacity -- writes past it are dropped but still counted, so the host learns
// the true visible count. The plane test is a conservative p-vertex AABB test,
// mirroring compactActiveBlocksInFrustum in hash_ops.metal. One atomic per
// surviving entry (the same simple form as hash_compact.comp).
// TODO(volume): subgroup-dedup the bump (one atomic per subgroup), as noted in
// hash_compact.comp.

#extension GL_GOOGLE_include_directive : require
#include "hash_common.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, scalar) readonly buffer Entries {
  HashEntry entries[];
};
layout(set = 0, binding = 1, scalar) writeonly buffer Output {
  BlockIndex active_blocks[];
};
layout(set = 0, binding = 2) buffer Count { uint active_count; };
// The frusta: their count, then six inward-normal, unit-length planes each
// (Hessian form), frustum f's at [6f, 6f + 6). A point p is inside plane i when
// dot(planes[i].xyz, p) + planes[i].w >= 0. Scalar layout puts the array at
// byte 4, where VoxelHashMap::upload_frusta writes it.
layout(set = 0, binding = 3, scalar) readonly buffer Frusta {
  uint frustum_count;
  vec4 planes[];
};

// Conservative AABB/frustum test: keep the box unless it lies fully outside some
// plane of frustum f. For each plane, test the box corner farthest along the
// inward normal (the "p-vertex"); if even that corner is outside, the whole box
// is.
bool aabb_in_frustum(uint f, vec3 bmin, vec3 bmax) {
  for (uint i = 6u * f; i < 6u * f + 6u; ++i) {
    vec3 n = planes[i].xyz;
    vec3 p = vec3(n.x >= 0.0 ? bmax.x : bmin.x, n.y >= 0.0 ? bmax.y : bmin.y,
                  n.z >= 0.0 ? bmax.z : bmin.z);
    if (dot(n, p) + planes[i].w < 0.0) {
      return false;
    }
  }
  return true;
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint total = uint(pc.grid.num_buckets * pc.grid.bucket_size);
  if (gid >= total) {
    return;
  }

  int ptr = entries[gid].ptr;
  if (ptr == kFreeEntry || ptr == kLockEntry) {
    return;
  }

  // Block world AABB, over the volume the block's voxels occupy and the
  // marching-cubes cells it meshes. Voxels are node-centred (voxel_to_world
  // puts voxel v at v * voxel_size), so block b's voxels cover
  // [b*bs*vs - vs/2, (b+1)*bs*vs - vs/2], and its cells span
  // [b*bs*vs, (b+1)*bs*vs], the last reaching the next block's first voxel.
  // bmin takes the voxels' edge and bmax the cells', so fusion (voxels) and
  // meshing (cells) both get a superset. No edge may fall short: each plane is
  // tested against one corner, and a box short of the cells dropped a block
  // whose voxels lay behind the near plane while its boundary cells'
  // triangles were in view.
  ivec3 coord = entries[gid].pos;
  float edge = float(pc.grid.block_size) * pc.grid.voxel_size;
  vec3 bmin = vec3(coord) * edge - vec3(0.5 * pc.grid.voxel_size);
  vec3 bmax = bmin + vec3(edge + 0.5 * pc.grid.voxel_size);
  bool kept = false;
  for (uint f = 0u; f < frustum_count && !kept; ++f) {
    kept = aabb_in_frustum(f, bmin, bmax);
  }
  if (!kept) {
    return;
  }

  uint index = atomicAdd(active_count, 1u);
  if (index < pc.arg) {
    active_blocks[index].coord = coord;
    active_blocks[index].ptr = ptr;
  }
}
