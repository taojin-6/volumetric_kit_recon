#version 450

// Projective texturing from several posed views into one atlas of their
// images. One thread per TRIANGLE, on an unshared mesh (vertices 3t..3t+2 are
// triangle t's): each triangle takes the view that sees it best, and all three
// of its vertices point into that view's tile. Choosing per vertex could not
// work here, since a triangle whose vertices took different views would
// interpolate uv0 across the atlas between two tiles.
//
// A view qualifies when all three vertices are in front of it, inside its
// image and unoccluded (their depth agrees with the view's depth map within
// the threshold). Among those, the score is |cos| of the angle between the
// triangle's normal and the ray to its centroid, less depth_weight times the
// smallest depth disagreement; the highest wins, the first on a tie. With no
// qualifying view all three vertices take the (-1, -1) sentinel, so the
// renderer uses the vertex colour. Every vertex is written on every call.
//
// Ported from implicit_surface_compression's triangles_to_uv_multicam_kernel
// (texture_mapping.cu) and the prior engine's texture mapper, which score the
// same way. The depth sampling and the occlusion test are texture_score.comp's,
// taking a view instead of the one camera; keep the two in step.

#extension GL_GOOGLE_include_directive : require
#include "texture_common.glsl"

layout(local_size_x = 256) in;

// One view (mirrors ViewParams in projective_texturer.cpp, 108 bytes under
// scalar layout): its camera, where its depth starts in depth[], and its
// tile's origin in the atlas. The tile is the camera's image size.
struct View {
  DepthCameraParams cam;
  uint depth_offset;
  uint tile_x;
  uint tile_y;
};

layout(set = 0, binding = 0, scalar) buffer Vertices { Vertex vertices[]; };
layout(set = 0, binding = 1, scalar) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 2, scalar) readonly buffer Views { View views[]; };

layout(push_constant, scalar) uniform PushConstants {
  uint num_triangles;         // bounds this dispatch
  uint num_views;
  uint atlas_width;
  uint atlas_height;
  float occlusion_threshold;  // max |projected depth - sensor depth|, metres
  float depth_weight;         // score cost per metre of depth disagreement
} pc;

// texture_score.comp's sample_depth, for view `v`: bilinear over the valid
// (> 0) taps, the nearest tap across a discontinuity wider than the threshold.
float sample_depth(uint v, float u, float vv) {
  DepthCameraParams c = views[v].cam;
  uint base = views[v].depth_offset;
  int w = int(c.width);
  int h = int(c.height);
  float cu = clamp(u, 0.0, float(w - 1));
  float cv = clamp(vv, 0.0, float(h - 1));
  int x0 = int(floor(cu));
  int y0 = int(floor(cv));
  int x1 = min(x0 + 1, w - 1);
  int y1 = min(y0 + 1, h - 1);
  float tx = cu - float(x0);
  float ty = cv - float(y0);
  float sm[4] = float[4](depth[base + uint(y0 * w + x0)],
                         depth[base + uint(y0 * w + x1)],
                         depth[base + uint(y1 * w + x0)],
                         depth[base + uint(y1 * w + x1)]);
  float wts[4] = float[4]((1.0 - tx) * (1.0 - ty), tx * (1.0 - ty),
                          (1.0 - tx) * ty, tx * ty);
  float total = 0.0;
  float result = 0.0;
  float lo = 3.4e38;
  float hi = 0.0;
  float d_near = 0.0;
  float best_w = -1.0;
  for (int i = 0; i < 4; i++) {
    if (sm[i] > 0.0) {
      result += wts[i] * sm[i];
      total += wts[i];
      lo = min(lo, sm[i]);
      hi = max(hi, sm[i]);
      if (wts[i] > best_w) {
        best_w = wts[i];
        d_near = sm[i];
      }
    }
  }
  if (total <= 0.0) {
    return 0.0;
  }
  if ((hi - lo) > pc.occlusion_threshold) {
    return d_near;
  }
  return result / total;
}

// texture_score.comp's occluded_ok, for view `v`, also giving the depth
// disagreement the score weighs.
bool visible_in(uint v, vec2 px, float zc, out float diff) {
  DepthCameraParams c = views[v].cam;
  diff = 0.0;
  if (!(px.x >= 1.0 && px.x < float(int(c.width) - 1) && px.y >= 1.0 &&
        px.y < float(int(c.height) - 1))) {
    return false;
  }
  float d = sample_depth(v, px.x, px.y);
  if (!(d >= c.min_depth && d <= c.max_depth)) {
    return false;
  }
  diff = abs(d - zc);
  return diff <= pc.occlusion_threshold;
}

// A pixel of view `v`'s image -> its atlas coordinate: +0.5 to the texel
// centre, clamped half a texel inside the TILE, so bilinear filtering never
// reaches the next view's image.
vec2 atlas_uv(uint v, vec2 px) {
  DepthCameraParams c = views[v].cam;
  float x = clamp(px.x + 0.5, 0.5, float(c.width) - 0.5);
  float y = clamp(px.y + 0.5, 0.5, float(c.height) - 0.5);
  return vec2((float(views[v].tile_x) + x) / float(pc.atlas_width),
              (float(views[v].tile_y) + y) / float(pc.atlas_height));
}

void main() {
  uint t = gl_GlobalInvocationID.x;
  if (t >= pc.num_triangles) {
    return;
  }
  uint first = 3u * t;
  vec3 world[3] = vec3[3](vertices[first].position,
                          vertices[first + 1u].position,
                          vertices[first + 2u].position);

  int best = -1;
  float best_score = 0.0;
  vec2 best_px[3];
  for (uint v = 0u; v < pc.num_views; v++) {
    DepthCameraParams c = views[v].cam;
    vec2 px[3];
    vec3 p_cam[3];
    float min_diff = 3.4e38;
    bool ok = true;
    for (int k = 0; k < 3 && ok; k++) {
      float zc;
      float diff;
      ok = project_to_image(c, world[k], px[k], zc) &&
           visible_in(v, px[k], zc, diff);
      if (ok) {
        min_diff = min(min_diff, diff);
        p_cam[k] = world_to_camera(c, world[k]);
      }
    }
    if (!ok) {
      continue;
    }
    vec3 n = cross(p_cam[1] - p_cam[0], p_cam[2] - p_cam[0]);
    vec3 middle = (p_cam[0] + p_cam[1] + p_cam[2]) / 3.0;
    float nn = dot(n, n);
    float cc = dot(middle, middle);
    float cos_angle = 0.0;
    if (nn > 1e-24 && cc > 1e-24) {
      cos_angle = abs(dot(n, middle)) * inversesqrt(nn) * inversesqrt(cc);
    }
    float score = cos_angle - pc.depth_weight * min_diff;
    if (best < 0 || score > best_score) {
      best = int(v);
      best_score = score;
      best_px = px;
    }
  }

  for (int k = 0; k < 3; k++) {
    vertices[first + uint(k)].uv0 =
        best >= 0 ? atlas_uv(uint(best), best_px[k]) : vec2(-1.0, -1.0);
  }
}
