// The integrate and clear dispatches' sizes, from the compaction's count left
// on the device (VoxelHashMap::record_compaction), so no count reaches the
// host between the two. A pass is a thread per voxel of every listed block,
// split as recon::detail::dispatch_items splits one whose size the host knows:
// dispatch d covers groups [d * per_dispatch, (d + 1) * per_dispatch), and a
// dispatch past the pass's end gets none.

#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 1) in;

layout(set = 0, binding = 0) readonly buffer ActiveCount {
  uint active_count;
};
// VkDispatchIndirectCommand each, 12 bytes apart under scalar layout.
layout(set = 0, binding = 1, scalar) writeonly buffer Args { uvec3 args[]; };

layout(push_constant, scalar) uniform Push {
  uint voxels_per_block;
  uint lanes;         // the integrate kernel's local_size_x
  uint per_dispatch;  // groups one dispatch holds
  uint dispatches;    // how many the host recorded
} pc;

void main() {
  // num_blocks * voxels_per_block fits an int32 (VoxelGridParams::validate),
  // so the product cannot wrap.
  const uint groups =
      (active_count * pc.voxels_per_block + pc.lanes - 1u) / pc.lanes;
  for (uint d = 0u; d < pc.dispatches; ++d) {
    const uint first = d * pc.per_dispatch;
    args[d] = uvec3(groups > first ? min(groups - first, pc.per_dispatch) : 0u,
                    1u, 1u);
  }
}
