#version 450

// Write a mesh's truncated distance field into a grid's tsdf/weight, one
// thread per voxel of every block the band reaches. Each voxel measures the
// triangles mesh_bin.comp filed under its block -- every triangle within
// trunc_dist of any of the block's voxels, since a bin holds each triangle
// within trunc_dist + half-diagonal of the block's centre -- so the minimum
// over the bin is the true minimum wherever the result is observed.
//
// Observed means within trunc_dist of the mesh, in both modes: that is the set
// the band test guarantees complete, and it is the set the allocation covers.
// An observed voxel gets weight 1 and its distance clamped to +-trunc_dist;
// every other voxel of the block gets tsdf 0, weight 0 -- a fresh block's
// zeros, which the mesher and the codec read as unobserved.
//
//   Signed -- +-distance, the sign from the angle-weighted pseudonormal of the
//             closest FEATURE (Baerentzen & Aanaes 2005): the face normal when
//             the closest point is inside a face, the edge's or the vertex's
//             pseudonormal when it is on one. A zero pseudonormal marks a rim
//             edge or vertex, where there is no side, and leaves the voxel
//             unobserved rather than signed.
//   Shell  -- distance - pc.shell: a thin solid around every triangle.
//
// The minimum breaks ties on the triangle index. The fill pass wrote each bin
// in atomic-arrival order, so "the first minimum" would name a different
// triangle from run to run whenever two tie -- which they do, along every
// shared edge and at every shared vertex -- and the same mesh would not write
// the same bytes.

#extension GL_GOOGLE_include_directive : require
#define VR_HASH_COMMON_NO_PUSH_CONSTANTS
#include "volumetric_kit/recon/volume/shaders/hash_common.glsl"
#include "volumetric_kit/recon/core/shaders/triangle_common.glsl"

layout(local_size_x = 256) in;

// One block to write: where it is, where its voxels live, and its bin.
// Scalar layout, 24 bytes, byte-identical to MeshBin in mesh_integrator.cpp.
struct MeshBin {
  ivec3 coord;
  int ptr;
  uint begin;
  uint count;
};

layout(set = 0, binding = 0, scalar) buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 1, scalar) buffer Weight { float weight[]; };
layout(set = 0, binding = 2, scalar) readonly buffer Vertices {
  vec3 vertices[];
};
layout(set = 0, binding = 3, scalar) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Bins { MeshBin bins[]; };
layout(set = 0, binding = 5, scalar) readonly buffer BinTris {
  uint bin_tris[];
};
// Signed only: one pseudonormal per (welded) vertex, and three per triangle,
// entry 3t + k for the edge from corner k to corner (k + 1) % 3. Zero on a rim.
layout(set = 0, binding = 6, scalar) readonly buffer VertexNormals {
  vec3 vertex_normals[];
};
layout(set = 0, binding = 7, scalar) readonly buffer EdgeNormals {
  vec3 edge_normals[];
};

// The write is split across dispatches so that none measures more than
// MeshIntegrator::kMaxDispatchBinEntries bin entries; this one writes bins
// [first_bin, first_bin + num_bins).
layout(push_constant, scalar) uniform PushConstants {
  VoxelGridParams grid;
  uint first_bin;
  uint num_bins;
  uint mode;    // kModeSigned or kModeShell (tsdf::MeshSdfMode)
  float shell;  // shell half-thickness, metres
} pc;

const uint kModeSigned = 0u;
const uint kModeShell = 1u;

// The normal that signs a voxel whose closest point is `feature` of triangle t.
vec3 pseudonormal(uint t, uint feature, vec3 a, vec3 b, vec3 c) {
  if (feature == kVrFeatureFace) {
    return cross(b - a, c - a);
  }
  if (feature <= kVrFeatureVertexC) {
    return vertex_normals[indices[3u * t + feature]];
  }
  return edge_normals[3u * t + (feature - kVrFeatureEdgeAB)];
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint vpb = uint(pc.grid.voxels_per_block);
  if (gid >= pc.num_bins * vpb) {
    return;
  }
  MeshBin bin = bins[pc.first_bin + gid / vpb];
  uint local = gid % vpb;

  // Node-centred voxels (voxel * voxel_size), matching
  // volume/voxel_coords.hpp::voxel_to_world and tsdf_integrate.comp.
  int bs = pc.grid.block_size;
  ivec3 lc = ivec3(int(local % uint(bs)), int((local / uint(bs)) % uint(bs)),
                   int(local / uint(bs * bs)));
  vec3 p = vec3(bin.coord * bs + lc) * pc.grid.voxel_size;

  float best_d2 = 3.4e38;
  uint best_t = 0xFFFFFFFFu;
  uint best_feature = kVrFeatureFace;
  vec3 best_closest = p;
  for (uint i = 0u; i < bin.count; ++i) {
    uint t = bin_tris[bin.begin + i];
    vec3 a = vertices[indices[3u * t]];
    vec3 b = vertices[indices[3u * t + 1u]];
    vec3 c = vertices[indices[3u * t + 2u]];
    uint feature;
    vec3 q = vrClosestPointOnTriangleFeature(p, a, b, c, feature);
    vec3 d = p - q;
    float d2 = dot(d, d);
    if (d2 < best_d2 || (d2 == best_d2 && t < best_t)) {
      best_d2 = d2;
      best_t = t;
      best_feature = feature;
      best_closest = q;
    }
  }

  float trunc_dist = pc.grid.trunc_dist;
  float dist = sqrt(best_d2);
  bool observed = best_t != 0xFFFFFFFFu && dist <= trunc_dist;
  float sdf = 0.0;
  if (observed) {
    if (pc.mode == kModeSigned) {
      vec3 a = vertices[indices[3u * best_t]];
      vec3 b = vertices[indices[3u * best_t + 1u]];
      vec3 c = vertices[indices[3u * best_t + 2u]];
      vec3 n = pseudonormal(best_t, best_feature, a, b, c);
      if (dot(n, n) > 0.0) {
        sdf = dot(p - best_closest, n) >= 0.0 ? dist : -dist;
      } else {
        observed = false;  // closest to a rim: no side to sign
      }
    } else {
      sdf = dist - pc.shell;
    }
  }

  uint idx = uint(bin.ptr) + local;
  tsdf[idx] = observed ? clamp(sdf, -trunc_dist, trunc_dist) : 0.0;
  weight[idx] = observed ? 1.0 : 0.0;
}
