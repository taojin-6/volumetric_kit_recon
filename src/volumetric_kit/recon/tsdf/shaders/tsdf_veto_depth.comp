// One fixed frame's depth copied into a set's veto depths, from element
// `first`: a set with a filler stacks its fixed frames' depths there, one
// after another, so the fill kernel reads every fixed frame through one
// binding (tsdf_integrate.glsl's vetoed). A storage read, as the frame's
// buffer need not allow a transfer. Each thread strides over the dispatch,
// so a frame past the device's group count is copied whole.

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, scalar) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 1, scalar) writeonly buffer Veto { float veto[]; };

layout(push_constant, scalar) uniform Push {
  uint count;  // the frame's pixels
  uint first;  // its first element in `veto`
} pc;

void main() {
  uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  for (uint i = gl_GlobalInvocationID.x; i < pc.count; i += stride) {
    veto[pc.first + i] = depth[i];
  }
}
