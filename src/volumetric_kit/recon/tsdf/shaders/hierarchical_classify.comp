#version 450

// Incoming observations can request detail that a coarse fused field has lost.
// Each sampled pixel estimates local departure from a tangent plane. This is
// deliberately a metric heuristic, not a confidence bound or motion detector.
#extension GL_GOOGLE_include_directive : require
#define VR_HASH_ENTRIES_BINDING 4
#define VR_HIERARCHY_NODES_BINDING 3
#include "volumetric_kit/recon/volume/shaders/hierarchical_lookup.glsl"

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, scalar) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 1, scalar) readonly buffer Camera {
  float fx;
  float fy;
  float cx;
  float cy;
  float min_depth;
  float max_depth;
  uint width;
  uint height;
  mat4 cam_to_world;
} cam;
layout(set = 0, binding = 2, scalar) buffer Requests { uint requests[]; };
layout(push_constant, scalar) uniform Push {
  VoxelGridParams root_grid;
  float finest_voxel_size;
  float surface_error;
  float noise_floor;
  uint max_level;
  uint node_capacity;
  uint pixel_stride;
  uint patch_radius;
  uint columns;
  uint sample_count;
} pc;

bool pointAt(ivec2 pixel, out vec3 point) {
  if (any(lessThan(pixel, ivec2(0))) ||
      pixel.x >= int(cam.width) || pixel.y >= int(cam.height)) return false;
  float d = depth[uint(pixel.y) * cam.width + uint(pixel.x)];
  if (!(d >= cam.min_depth && d <= cam.max_depth)) return false;
  point = vec3((float(pixel.x) + 0.5 - cam.cx) * d / cam.fx,
               (float(pixel.y) + 0.5 - cam.cy) * d / cam.fy, d);
  return true;
}

void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index >= pc.sample_count) return;
  ivec2 pixel = ivec2(index % pc.columns, index / pc.columns) * int(pc.pixel_stride);
  vec3 center;
  if (!pointAt(pixel, center)) return;
  vec3 world = (cam.cam_to_world * vec4(center, 1.0)).xyz;
  vec3 q = floor(world / pc.finest_voxel_size);
  // Leave headroom for neighbor offsets and signed coordinate products in
  // downstream integer sampling; NaN also fails these comparisons.
  if (!all(greaterThan(q, vec3(-1073741824.0))) ||
      !all(lessThan(q, vec3(1073741824.0)))) return;
  uint node_id;
  ivec3 local;
  if (!vrHierarchyLocate(ivec3(q), pc.root_grid, pc.max_level,
                          pc.node_capacity, node_id, local)) return;

  int radius = int(pc.patch_radius);
  vec3 points[8];
  const ivec2 shifts[8] = ivec2[8](ivec2(-1, 0), ivec2(1, 0),
      ivec2(0, -1), ivec2(0, 1), ivec2(-1, -1), ivec2(1, -1),
      ivec2(-1, 1), ivec2(1, 1));
  bool discontinuity = false;
  for (int i = 0; i < 8; ++i) {
    if (!pointAt(pixel + radius * shifts[i], points[i])) return;
    discontinuity = discontinuity ||
        abs(points[i].z - center.z) > pc.root_grid.trunc_dist;
  }
  vec3 normal = cross(points[1] - points[0], points[3] - points[2]);
  float magnitude = length(normal);
  if (!(magnitude > 1e-10)) return;
  normal /= magnitude;
  float residual = 0.0;
  float radius2 = 0.0;
  for (int i = 0; i < 8; ++i) {
    vec3 delta = points[i] - center;
    residual = max(residual, abs(dot(normal, delta)));
    radius2 = max(radius2, dot(delta, delta));
  }
  residual = max(0.0, residual - pc.noise_floor);
  // Large camera-Z slope alone also occurs on a grazing plane. Require
  // measured nonplanarity before treating it as a depth discontinuity.
  discontinuity = discontinuity && residual > pc.surface_error;
  uint desired = 0u;
  if (!discontinuity) {
    // A smooth patch's departure from its tangent plane is quadratic in
    // length. Choose the coarsest candidate that fits this local estimate.
    for (uint level = 1u; level <= pc.max_level; ++level) {
      float spacing = pc.finest_voxel_size * float(1u << level);
      float estimate = residual * spacing * spacing / max(radius2, 1e-12);
      if (estimate <= pc.surface_error) desired = level;
    }
  }
  atomicMin(requests[node_id], desired);
}
