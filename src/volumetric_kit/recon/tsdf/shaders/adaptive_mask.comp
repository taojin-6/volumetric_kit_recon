// The depth a finer grid allocates from: each pixel keeps its depth when its
// point lies in a coarse block flagged for refinement, and reads 0 (invalid)
// otherwise. Integration still takes the full image, so the finer grid's
// existing blocks keep carving free space.

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#define VR_HASH_ENTRIES_BINDING 1
#include "volumetric_kit/recon/volume/shaders/hash_lookup.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, scalar) readonly buffer Depth { float depth[]; };
// Per coarse block slot: the block flagged there at the last check. The coord
// tells it from a block that took the slot since.
struct RefineFlag {
  ivec3 coord;
  uint refined;
};
layout(set = 0, binding = 2, scalar) readonly buffer Flags {
  RefineFlag flags[];
};
layout(set = 0, binding = 3, scalar) writeonly buffer Masked {
  float masked[];
};

#include "adaptive_common.glsl"

layout(set = 0, binding = 4, scalar) readonly buffer Camera {
  DepthCameraParams cam;
};

layout(push_constant, scalar) uniform Push { VoxelGridParams coarse; } pc;

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= cam.width * cam.height) return;
  vec3 p;
  float kept = 0.0;
  if (unproject(cam, id % cam.width, id / cam.width, p)) {
    vec3 w = (cam.cam_to_world * vec4(p, 1.0)).xyz;
    ivec3 block = region_block(w, pc.coarse.voxel_size);
    int ptr = vrFindBlockPtr(block, pc.coarse.num_buckets,
                             pc.coarse.bucket_size, pc.coarse.max_chain);
    if (ptr >= 0) {
      RefineFlag f = flags[uint(ptr) / uint(pc.coarse.voxels_per_block)];
      if (f.refined != 0u && f.coord == block) kept = depth[id];
    }
  }
  masked[id] = kept;
}
