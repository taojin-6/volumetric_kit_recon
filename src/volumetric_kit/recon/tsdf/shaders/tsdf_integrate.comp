#version 450

// Projective TSDF integration (classic or dynamic). One thread per voxel of each
// active block: project the voxel centre into the depth camera, compute the
// truncated signed distance (sdf = depth - Zc, positive in front of the
// surface), and fuse it into the tsdf/weight attributes by a weighted running
// average. Dynamic mode additionally hard-clears a voxel that projects into free
// space past the truncation band (a surface that has receded). Ported from
// classic_tsdf.metal / classic_tsdf.cu (the neural/triplane channels are out of
// scope). Each voxel is owned by exactly one thread (a unique block ptr + local
// index), so the read-modify-write needs no atomics.

#extension GL_GOOGLE_include_directive : require
#include "tsdf_common.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, scalar) buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 1, scalar) buffer Weight { float weight[]; };
layout(set = 0, binding = 2, scalar) readonly buffer Active {
  BlockIndex active_blocks[];
};
layout(set = 0, binding = 3, scalar) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Camera {
  DepthCameraParams cam;
};
// Color path, read only when pc.has_color != 0 (a 1-element dummy otherwise).
// RGB packed in a uint's low three bytes -- the mesh tier's `colors[]` layout,
// so meshing reads the fused color attribute directly.
layout(set = 0, binding = 5) readonly buffer ColorImage { uint color_image[]; };
layout(set = 0, binding = 6) buffer ColorAttr { uint color_attr[]; };
layout(set = 0, binding = 7, scalar) readonly buffer ColorCamera {
  DepthCameraParams color_cam;
};

// Bilinear depth sample at pixel (u, v), with a nearest-neighbour fallback.
// Pixel centres sit at (i + 0.5) -- the taps shift by -0.5 to match -- so the
// "nearest" (containing) pixel is floor(u), floor(v), i.e. int(u), int(v) given
// the caller's u, v >= 0. Falls back to that sample when a bilinear tap is out
// of bounds, invalid (<= 0), or the four taps straddle a depth discontinuity
// (max - min > trunc_dist) that would blend across a surface edge. This
// texture-centred convention -- taps *and* fallback -- is a deliberate recon
// choice (see CLAUDE.md, the depth-sampling decision); it is self-consistent,
// unlike the prior engine's sampleDepthBilinear, which rounded the fallback to
// an integer centre while shifting the taps. (u, v) is in [0, width) x
// [0, height). The nearest index is computed here but only read on a fallback
// return, so the common interpolate path loads just the four taps.
float sample_depth(float u, float v) {
  int w = int(cam.width);
  int h = int(cam.height);
  int nu = int(u);  // nearest (containing) pixel; loaded only on fallback below
  int nv = int(v);

  // Taps at pixel centres (shift by -0.5): the 2x2 block [x0,x0+1]x[y0,y0+1].
  float su = u - 0.5;
  float sv = v - 0.5;
  int x0 = int(floor(su));
  int y0 = int(floor(sv));
  if (x0 < 0 || y0 < 0 || x0 + 1 >= w || y0 + 1 >= h) {
    return depth[nv * w + nu];  // a bilinear tap is out of bounds
  }
  float d00 = depth[y0 * w + x0];
  float d10 = depth[y0 * w + x0 + 1];
  float d01 = depth[(y0 + 1) * w + x0];
  float d11 = depth[(y0 + 1) * w + x0 + 1];
  float lo = min(min(d00, d10), min(d01, d11));
  float hi = max(max(d00, d10), max(d01, d11));
  if (lo <= 0.0 || (hi - lo) > pc.grid.trunc_dist) {
    return depth[nv * w + nu];  // an invalid tap, or a depth discontinuity across the taps
  }
  float fx = su - float(x0);
  float fy = sv - float(y0);
  return mix(mix(d00, d10, fx), mix(d01, d11, fx), fy);
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  uint vpb = uint(pc.grid.voxels_per_block);
  if (gid >= pc.num_active_blocks * vpb) {
    return;
  }
  uint block_i = gid / vpb;
  uint local = gid % vpb;
  BlockIndex block = active_blocks[block_i];

  // Voxel world position: node convention (voxel * voxel_size), matching
  // volume/voxel_coords.hpp::voxel_to_world and the prior engine.
  int bs = pc.grid.block_size;
  ivec3 lc = ivec3(int(local % uint(bs)), int((local / uint(bs)) % uint(bs)),
                   int(local / uint(bs * bs)));
  ivec3 voxel = block.coord * bs + lc;
  vec3 world = vec3(voxel) * pc.grid.voxel_size;

  // Project into the depth camera. cam_to_world is a rigid transform, so
  // world -> camera is R^T (world - t) -- no explicit inverse, and cheaper than
  // a full mat4 multiply by the pre-inverted pose.
  mat3 rot = mat3(cam.cam_to_world);
  vec3 t = cam.cam_to_world[3].xyz;
  vec3 p_cam = transpose(rot) * (world - t);
  float zc = p_cam.z;
  if (zc <= 0.0) {
    return;  // behind the camera
  }
  float u = cam.fx * (p_cam.x / zc) + cam.cx;
  float v = cam.fy * (p_cam.y / zc) + cam.cy;
  if (u < 0.0 || u >= float(cam.width) || v < 0.0 || v >= float(cam.height)) {
    return;  // outside the image
  }
  float d = sample_depth(u, v);  // bilinear, with nearest-neighbour fallback
  // Reject out-of-range depth; the negated compare also drops NaN/inf holes
  // (every comparison with NaN is false), matching hash_allocate_depth.comp so
  // integration accepts exactly the near/far range allocation did.
  if (!(d >= cam.min_depth && d <= cam.max_depth)) {
    return;  // invalid / out-of-range / non-finite depth
  }

  // Truncated projective SDF.
  float trunc_dist = pc.grid.trunc_dist;
  float sdf = d - zc;
  if (sdf < -trunc_dist) {
    return;  // occluded: well behind the surface
  }
  uint idx = uint(block.ptr) + local;
  if (sdf > trunc_dist && pc.mode == kModeDynamic) {
    // Free space in front of the surface, past the band: under dynamic
    // integration the surface has receded past this voxel, so hard-clear any
    // stale geometry back to the pristine unobserved state (tsdf 0 / weight 0 --
    // the zeroed initial state), which weight-gated readers treat as empty. Free
    // space is never fused here (classic instead clamps to +trunc, keeping a
    // smooth field ahead of the surface). Matches the prior engine's
    // classic_tsdf.cu stale-clearing branch, which zeroes color here too.
    if (weight[idx] > 0.0) {
      tsdf[idx] = 0.0;
      weight[idx] = 0.0;
      if (pc.has_color != 0u) {
        color_attr[idx] = 0u;  // drop stale color along with the geometry
      }
    }
    return;
  }
  sdf = clamp(sdf, -trunc_dist, trunc_dist);

  // Inverse-square observation weight with a linear behind-surface dropoff.
  float w_obs = (zc > 0.01) ? (1.0 / (zc * zc)) : 1.0;
  if (zc > d) {
    // Behind the surface but within the band -- the earlier sdf < -trunc_dist
    // return already guarantees behind <= trunc_dist. Fade linearly to zero at
    // the band edge, where the w_obs <= 0.0 guard below drops the sample.
    float behind = zc - d;
    w_obs *= (trunc_dist - behind) / trunc_dist;
  }
  if (w_obs <= 0.0) {
    return;
  }

  // Weighted running average, capped at max_weight.
  float w_old = weight[idx];
  float s_old = tsdf[idx];
  float w_sum = w_old + w_obs;
  tsdf[idx] = clamp((s_old * w_old + sdf * w_obs) / max(w_sum, 1e-6),
                    -trunc_dist, trunc_dist);
  weight[idx] = min(w_sum, pc.max_weight);

  // Fuse color, if present, through the separate color camera. Project this
  // voxel into the color camera (its own rigid pose), nearest-sample the packed
  // RGB, and running-average it with the same weights as the SDF (a first
  // observation assigns). RGB stays in the uint's low bytes, matching the mesh
  // tier's color attribute.
  if (pc.has_color != 0u) {
    mat3 crot = mat3(color_cam.cam_to_world);
    vec3 ct = color_cam.cam_to_world[3].xyz;
    vec3 cp = transpose(crot) * (world - ct);
    if (cp.z > 0.0) {
      float cu = color_cam.fx * (cp.x / cp.z) + color_cam.cx;
      float cv = color_cam.fy * (cp.y / cp.z) + color_cam.cy;
      if (cu >= 0.0 && cu < float(color_cam.width) && cv >= 0.0 &&
          cv < float(color_cam.height)) {
        vec3 obs =
            unpackUnorm4x8(color_image[uint(cv) * color_cam.width + uint(cu)])
                .rgb;
        vec3 prev = unpackUnorm4x8(color_attr[idx]).rgb;
        vec3 fused = (w_old < 1e-4)
                         ? obs
                         : (prev * w_old + obs * w_obs) / max(w_sum, 1e-6);
        color_attr[idx] = packUnorm4x8(vec4(fused, 1.0));
      }
    }
  }
}
