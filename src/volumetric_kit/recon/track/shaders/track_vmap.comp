#version 450

// An entry's vertex and normal maps at one level, in the camera's frame. A
// pixel is kept only when it returned, is off the image border, has no depth
// edge within `edge` pixels, and faces its ray within the grazing angle. An
// edge is a 4-neighbour pair one of which has no return, or whose depths
// differ by more than 3 cm + 1 % of the first's. The normal is the cross
// product of the central differences, turned to face the camera.

#extension GL_GOOGLE_include_directive : require
#include "track_common.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, scalar) readonly buffer Depth { float depth[]; };
// w = 1 where kept, 0 elsewhere (then all 0).
layout(set = 0, binding = 1, scalar) writeonly buffer Vtx { vec4 vtx[]; };
layout(set = 0, binding = 2, scalar) writeonly buffer Nrm { vec4 nrm[]; };

// Mirrors VmapPush.
layout(push_constant, scalar) uniform Push {
  uint width;
  uint height;
  uint offset;  // the entry's first element
  int edge;     // the band dropped beside an edge (pixels)
  vec4 k;       // the level's fx, fy, cx, cy
  float cos_graze;
} pc;

float at(int x, int y) {
  return depth[pc.offset + uint(y) * pc.width + uint(x)];
}

// Whether the pair (a, b), b right of or below a, is a depth edge.
bool split(float a, float b) {
  return !(a > 0.0) || !(b > 0.0) || abs(a - b) > 0.03 + 0.01 * a;
}

// Whether pixel (x, y) is in an edge pair with a neighbour inside the image.
bool on_edge(int x, int y) {
  int w = int(pc.width);
  int h = int(pc.height);
  float d = at(x, y);
  if (x + 1 < w && split(d, at(x + 1, y))) return true;
  if (x > 0 && split(at(x - 1, y), d)) return true;
  if (y + 1 < h && split(d, at(x, y + 1))) return true;
  if (y > 0 && split(at(x, y - 1), d)) return true;
  return false;
}

void main() {
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= pc.width * pc.height) {
    return;
  }
  int x = int(gid % pc.width);
  int y = int(gid / pc.width);
  uint i = pc.offset + gid;
  vtx[i] = vec4(0.0);
  nrm[i] = vec4(0.0);
  int w = int(pc.width);
  int h = int(pc.height);
  float z = at(x, y);
  if (!(z > 0.0) || x == 0 || y == 0 || x == w - 1 || y == h - 1) {
    return;
  }
  for (int dy = -pc.edge; dy <= pc.edge; ++dy) {
    for (int dx = -pc.edge; dx <= pc.edge; ++dx) {
      int xx = x + dx;
      int yy = y + dy;
      if (xx < 0 || yy < 0 || xx >= w || yy >= h) continue;
      if (on_edge(xx, yy)) return;
    }
  }
  vec3 p = vs_unproject_pinhole(vec2(x, y), z, pc.k);
  vec3 px0 = vs_unproject_pinhole(vec2(x - 1, y), at(x - 1, y), pc.k);
  vec3 px1 = vs_unproject_pinhole(vec2(x + 1, y), at(x + 1, y), pc.k);
  vec3 py0 = vs_unproject_pinhole(vec2(x, y - 1), at(x, y - 1), pc.k);
  vec3 py1 = vs_unproject_pinhole(vec2(x, y + 1), at(x, y + 1), pc.k);
  vec3 n = cross(px1 - px0, py1 - py0);
  float len = length(n);
  if (!(len > 1e-12)) {
    return;
  }
  n /= len;
  if (dot(n, p) > 0.0) {
    n = -n;
  }
  if (-dot(n, normalize(p)) < pc.cos_graze) {
    return;  // grazing
  }
  vtx[i] = vec4(p, 1.0);
  nrm[i] = vec4(n, 0.0);
}
