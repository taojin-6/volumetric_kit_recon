#version 450

// A slot's level-0 depth, in place: a sample outside the frame's
// [min_depth, max_depth], or not finite, is no return (0).

#extension GL_GOOGLE_include_directive : require
#include "track_common.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0, scalar) buffer Depth { float depth[]; };

// Mirrors FilterPush.
layout(push_constant, scalar) uniform Push {
  uint pixels;  // the level's width * height
  uint offset;  // the slot's first element
  float min_depth;
  float max_depth;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.pixels) {
    return;
  }
  float d = depth[pc.offset + i];
  // Negated, so a NaN is no return.
  if (!(d >= pc.min_depth && d <= pc.max_depth)) {
    depth[pc.offset + i] = 0.0;
  }
}
