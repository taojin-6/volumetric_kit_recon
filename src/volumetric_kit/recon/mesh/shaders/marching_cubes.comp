#version 450

// Marching-cubes extraction over a DENSE voxel-sample grid: one invocation per
// cell, build the cube index from the eight corner signs, interpolate a vertex
// on each crossed edge, and append independent triangles (three fresh vertices
// each -- no shared-edge dedup) through an atomic bump counter. This is the
// simple, correct form that proves the GLSL marching-cubes path on MoltenVK;
// shared-vertex dedup and an incremental block-mesh pool are later slices.
// Extraction straight off the sparse voxel hash map (with cross-block neighbour
// sampling) is marching_cubes_sparse.comp -- only its corner *sampling* differs;
// the per-cell body (cube index, gradient normal, reversed-winding triangle
// emission, hybrid vertex colour) is the shared marching_cubes_common.glsl both
// kernels include. Ported from the prior engine's fused block kernel, minus the
// block machinery the dense path does not need.
//
// Each vertex also carries the hybrid appearance the renderer's
// HybridMeshPipeline consumes: a per-vertex color (interpolated from the
// optional color input at the same edge ratio as the position -- the TSDF
// vertex-color fallback) and a uv0 that this kernel leaves at the (-1, -1)
// sentinel meaning "no atlas; use the vertex color" (the projective-texturing
// pass overwrites it for textured triangles in a later slice).
//
// The lookup tables live in a host-uploaded storage buffer (one definition
// across CPU/GLSL, mirroring the volume tier's POD discipline); Voxel and Vertex
// are read/written through scalar block layout so they match the host structs
// (volume/hash_types.hpp Voxel: sdf@0, weight@4, 8 B; mesh Vertex: position@0,
// normal@12, color@24, uv0@40, 48 B) byte-for-byte.

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cross-tier: the one transfer curve, from core.
#include "volumetric_kit/recon/core/shaders/color_common.glsl"

layout(local_size_x = 256) in;

// Per-voxel signed-distance payload (mirrors volume::Voxel).
struct Voxel {
  float sdf;
  float weight;
};

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;  // renderer's slot; meshing has no parameterisation for one
  vec2 uv0;
  vec4 color;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];    // [256][16]
  int corner_offset[24];  // [8][3]
  int edge_to_vert[24];   // [12][2]
};
layout(set = 0, binding = 1, scalar) readonly buffer Samples {
  Voxel samples[];
};
// Per-sample RGB packed into a uint's low three bytes (unpackUnorm4x8 -> .rgb),
// parallel to `samples`; read only when pc.has_color != 0 (else a 1-element
// dummy is bound). `scalar` like every other data binding: a uint[] is stride 4
// under scalar and std430 alike, so this is not a live layout change, but it
// keeps the ABI discipline uniform so a future vec-bearing color type cannot
// silently inherit std430's vec padding.
layout(set = 0, binding = 2, scalar) readonly buffer Colors { uint colors[]; };
layout(set = 0, binding = 3, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
layout(set = 0, binding = 4) buffer Counter { uint tri_count; };

layout(push_constant, scalar) uniform PushConstants {
  ivec3 dims;              // sample count per axis (cells = dims - 1)
  float voxel_size;        // metres between adjacent samples
  vec3 origin;             // world position of sample (0, 0, 0)
  float iso;               // iso-value to extract
  uint capacity;           // max triangles the vertex buffer holds
  float weight_threshold;  // corners below this weight invalidate the cell
  uint has_color;          // 0 = no color input; vertices get opaque white
} pc;

// Linear index of sample (x, y, z), x-fastest.
int sampleIndex(ivec3 c) {
  return c.x + pc.dims.x * (c.y + pc.dims.y * c.z);
}

// mcCornerShift / mcCellNormal / mcEmitCell + the near-tangent edge guard, over
// the Tables / Vertices / Counter bindings declared above.
#include "marching_cubes_common.glsl"

void main() {
  ivec3 cell_dims = pc.dims - ivec3(1);
  uint total = uint(cell_dims.x * cell_dims.y * cell_dims.z);
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= total) {
    return;
  }

  // Decode the flat cell id into a cell coordinate (x-fastest).
  int cx = int(gid) % cell_dims.x;
  int cy = (int(gid) / cell_dims.x) % cell_dims.y;
  int cz = int(gid) / (cell_dims.x * cell_dims.y);
  ivec3 base = ivec3(cx, cy, cz);

  // Gather the eight corners; a corner below the weight threshold is an
  // unintegrated voxel, so the whole cell is skipped (no extrapolation). Color
  // (when supplied) is gathered alongside the SDF for per-edge interpolation.
  float sdf[8];
  vec3 corner_color[8];
  int cube_index = 0;
  for (int i = 0; i < 8; ++i) {
    int si = sampleIndex(base + mcCornerShift(i));
    Voxel v = samples[si];
    if (v.weight < pc.weight_threshold) {
      return;
    }
    sdf[i] = v.sdf;
    if (pc.has_color != 0u) {
      // Decode here: the per-voxel colour is canonical-encoded 8-bit, but
      // mcEmitCell interpolates it along the cell edge and an interpolation is
      // an average, so the corners enter the shared body as LINEAR working
      // values and leave as a linear Vertex::color (the 2026-08-02 decision).
      corner_color[i] = vrUnpackSrgbToLinear(colors[si]);
    }
    if (sdf[i] < pc.iso) {
      cube_index |= (1 << i);
    }
  }
  if (cube_index == 0 || cube_index == 255) {
    return;  // no sign change -> no surface in this cell
  }

  // The cell is anchored on its own base coordinate with the grid `origin`; the
  // shared body computes the gradient normal, reverses winding, and interpolates
  // colour.
  vec3 normal = mcCellNormal(sdf);
  mcEmitCell(cube_index, sdf, corner_color, pc.origin, base, pc.voxel_size,
             normal, pc.iso, pc.has_color, pc.capacity);
}
