#version 450

// Marching-cubes extraction over a DENSE voxel-sample grid: one invocation per
// cell, build the cube index from the eight corner signs, interpolate a vertex
// on each crossed edge, and append independent triangles (three fresh vertices
// each -- no shared-edge dedup) through an atomic bump counter. This is the
// simple, correct form that proves the GLSL marching-cubes path on MoltenVK;
// shared-vertex dedup, an incremental block-mesh pool, and extraction straight
// off the sparse voxel hash map (with cross-block neighbour sampling) are later
// slices. Ported from the prior engine's fused block kernel, minus the block
// machinery the dense path does not need.
//
// The lookup tables live in a host-uploaded storage buffer (one definition
// across CPU/GLSL, mirroring the volume tier's POD discipline); Voxel and Vertex
// are read/written through scalar block layout so they match the host structs
// (volume/hash_types.hpp Voxel: sdf@0, weight@4, 8 B; mesh Vertex: position@0,
// normal@12, 24 B) byte-for-byte.

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

// Per-voxel signed-distance payload (mirrors volume::Voxel).
struct Voxel {
  float sdf;
  float weight;
};

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];      // [256][16]
  int corner_offset[24];    // [8][3]
  int edge_to_vert[24];     // [12][2]
};
layout(set = 0, binding = 1, scalar) readonly buffer Samples {
  Voxel samples[];
};
layout(set = 0, binding = 2, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
layout(set = 0, binding = 3) buffer Counter { uint tri_count; };

layout(push_constant, scalar) uniform PushConstants {
  ivec3 dims;             // sample count per axis (cells = dims - 1)
  float voxel_size;       // metres between adjacent samples
  vec3 origin;            // world position of sample (0, 0, 0)
  float iso;              // iso-value to extract
  uint capacity;          // max triangles the vertex buffer holds
  float weight_threshold; // corners below this weight invalidate the cell
} pc;

// Linear index of sample (x, y, z), x-fastest.
int sampleIndex(ivec3 c) {
  return c.x + pc.dims.x * (c.y + pc.dims.y * c.z);
}

// Corner c's step (0/1 per axis) from the cell base.
ivec3 cornerShift(int corner) {
  return ivec3(corner_offset[corner * 3 + 0], corner_offset[corner * 3 + 1],
               corner_offset[corner * 3 + 2]);
}

// World position where the iso-surface crosses the edge between corners a and b.
vec3 edgeVertex(ivec3 base, int a, int b, float sa, float sb) {
  vec3 pa = pc.origin + vec3(base + cornerShift(a)) * pc.voxel_size;
  vec3 pb = pc.origin + vec3(base + cornerShift(b)) * pc.voxel_size;
  float denom = sb - sa;
  // Guard the near-tangent case so the ratio stays finite (mirrors the prior
  // engine's copysign(kEpsilon) guard); clamp keeps the vertex on the segment.
  if (abs(denom) < 1e-6) {
    denom = denom < 0.0 ? -1e-6 : 1e-6;
  }
  float t = clamp((pc.iso - sa) / denom, 0.0, 1.0);
  return pa + t * (pb - pa);
}

void main() {
  ivec3 cell_dims = pc.dims - ivec3(1);
  uint total = uint(cell_dims.x * cell_dims.y * cell_dims.z);
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= total) {
    return;
  }

  // Decode the flat cell id into a cell coordinate (x-fastest).
  int cx = int(gid) % cell_dims.x;
  int cy = (int(gid) / cell_dims.x) % cell_dims.y;
  int cz = int(gid) / (cell_dims.x * cell_dims.y);
  ivec3 base = ivec3(cx, cy, cz);

  // Gather the eight corners; a corner below the weight threshold is an
  // unintegrated voxel, so the whole cell is skipped (no extrapolation).
  float sdf[8];
  int cube_index = 0;
  for (int i = 0; i < 8; ++i) {
    Voxel v = samples[sampleIndex(base + cornerShift(i))];
    if (v.weight < pc.weight_threshold) {
      return;
    }
    sdf[i] = v.sdf;
    if (sdf[i] < pc.iso) {
      cube_index |= (1 << i);
    }
  }
  if (cube_index == 0 || cube_index == 255) {
    return;  // no sign change -> no surface in this cell
  }

  // One normal per cell from the 8-corner central-difference gradient (points
  // toward increasing distance, i.e. outward); shared by the cell's vertices.
  // The 1/(4*voxel_size) scale is dropped -- it cancels under normalization.
  vec3 grad =
      vec3((sdf[1] + sdf[2] + sdf[5] + sdf[6]) - (sdf[0] + sdf[3] + sdf[4] + sdf[7]),
           (sdf[2] + sdf[3] + sdf[6] + sdf[7]) - (sdf[0] + sdf[1] + sdf[4] + sdf[5]),
           (sdf[4] + sdf[5] + sdf[6] + sdf[7]) - (sdf[0] + sdf[1] + sdf[2] + sdf[3]));
  float glen = length(grad);
  vec3 normal = glen > 1e-6 ? grad / glen : vec3(0.0, 0.0, 1.0);

  for (int t = 0; tri_table[cube_index * 16 + t] != -1; t += 3) {
    vec3 p[3];
    for (int k = 0; k < 3; ++k) {
      int edge = tri_table[cube_index * 16 + t + k];
      int a = edge_to_vert[edge * 2 + 0];
      int b = edge_to_vert[edge * 2 + 1];
      p[k] = edgeVertex(base, a, b, sdf[a], sdf[b]);
    }
    uint tri = atomicAdd(tri_count, 1u);
    if (tri >= pc.capacity) {
      // Past capacity: drop. tri_count ends above capacity so the host detects
      // the overflow -- though not the exact demand, since this invocation
      // abandons the rest of the cell. Unreachable while capacity is 5/cell.
      return;
    }
    // Emit with reversed winding (0, 2, 1) so the front face (CCW) points along
    // the outward gradient normal -- the orientation gfx expects, and the one
    // that makes each vertex's normal agree with the vertex order. The standard
    // tri_table winds the opposite way for this corner numbering; the prior
    // engine shaded from the gradient normal, so its winding was unobserved.
    uint vbase = tri * 3u;
    vertices[vbase + 0u].position = p[0];
    vertices[vbase + 1u].position = p[2];
    vertices[vbase + 2u].position = p[1];
    vertices[vbase + 0u].normal = normal;
    vertices[vbase + 1u].normal = normal;
    vertices[vbase + 2u].normal = normal;
  }
}
