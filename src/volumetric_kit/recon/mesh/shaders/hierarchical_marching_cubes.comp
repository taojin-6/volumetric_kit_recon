#version 450
#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cell-centered dual construction: Wald, arXiv:2004.08475 (2020).
// Enumerate a leaf's 9^3 primal vertices once, rather than eight candidates
// per sample. The finest incident leaf, then lowest (z,y,x) leaf coordinate,
// owns the dual cell. Strict-interior candidates use no hierarchy lookup.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];
  int corner_offset[24];
  int edge_to_vert[24];
};
#define VR_HASH_ENTRIES_BINDING 1
#define VR_HIERARCHY_NODES_BINDING 2
#include "volumetric_kit/recon/volume/shaders/hierarchical_lookup.glsl"
layout(set = 0, binding = 3, scalar) readonly buffer Leaves { uint leaves[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Distances { float tsdf[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Weights { float weights[]; };
layout(set = 0, binding = 6, scalar) readonly buffer Colors { uint colors[]; };
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;
  vec2 uv0;
  vec4 color;
};
layout(set = 0, binding = 7, scalar) writeonly buffer Vertices { Vertex vertices[]; };
layout(set = 0, binding = 8, scalar) writeonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 9, scalar) buffer Command {
  uint index_count;
  uint instance_count;
  uint first_index;
  int vertex_offset;
  uint first_instance;
  uint rejected;
};
layout(push_constant, scalar) uniform Push {
  uint leaf_count;
  uint leaf_base;
  uint node_capacity;
  uint max_level;
  int num_buckets;
  int bucket_size;
  int max_chain;
  uint capacity;
  float voxel_size;
  float iso;
  float weight_threshold;
  uint has_color;
} pc;

#include "volumetric_kit/recon/core/shaders/color_common.glsl"
#include "marching_cubes_common.glsl"

struct Sample {
  ivec3 lower;
  vec3 position;
  vec3 color;
  float distance;
};
// Invocation-private scratch, overwritten by every active gather. Passing this
// array by value through triangle/crossing makes SPIRV-Cross generate several
// whole-array copies per triangle; direct access preserves reference use in
// MSL without requiring compiler-specific optimization flags.
Sample samples[8];
bool samples_regular;
shared uint block_count;
shared uint block_base;
shared uint block_cursor;
shared HierarchicalNode neighbor_nodes[27];
shared uint neighbor_valid[27];
shared float sign_tile[1000];
shared uint tile_signs;

bool coordLess(ivec3 a, ivec3 b) {
  return a.z != b.z ? a.z < b.z : (a.y != b.y ? a.y < b.y : a.x < b.x);
}

bool sampleCellStorage(HierarchicalNode owner, ivec3 local, ivec3 query,
                       out HierarchicalNode node, out uint index) {
  node = owner;
  if (any(lessThan(local, ivec3(0))) || any(greaterThanEqual(local, ivec3(8)))) {
    ivec3 region = ivec3(lessThan(local, ivec3(0))) * -1 + ivec3(greaterThanEqual(local, ivec3(8)));
    int ni = region.x + 1 + 3 * (region.y + 1 + 3 * (region.z + 1));
    if (neighbor_valid[ni] == 0u) return false;
    node = neighbor_nodes[ni];
    // Signed GLSL right shift is arithmetic, hence exact floor division by
    // 2^level even for negative cells, without runtime signed integer divide.
    local = (query >> int(node.level)) - node.coord * 8;
  }
  index = uint(node.ptr) + uint(local.x + 8 * (local.y + 8 * local.z));
  return true;
}

bool sampleStorage(HierarchicalNode owner, ivec3 corner, ivec3 q, int c,
                   out HierarchicalNode node, out ivec3 query, out uint index) {
  ivec3 shift = mcCornerShift(c);
  ivec3 local = corner + shift - ivec3(1);
  query = q + shift - ivec3(1);
  return sampleCellStorage(owner, local, query, node, index);
}

// Most candidates do not cross the surface. Reject those using only signs and
// observation weights, before building private sample arrays or interpolating
// geometry. Active cells still use the exact coincident/area filter below.
bool cellSigns(uint candidate, out int code) {
  code = 0;
  ivec3 corner = ivec3(int(candidate % 9u), int((candidate / 9u) % 9u), int(candidate / 81u));
  for (int c = 0; c < 8; ++c) {
    ivec3 local = corner + mcCornerShift(c);
    float d = sign_tile[local.x + 10 * (local.y + 10 * local.z)];
    if (isnan(d)) return false;
    if (d < pc.iso) code |= 1 << c;
  }
  return code != 0 && code != 255;
}

bool gather(HierarchicalNode owner, uint candidate, bool need_color, out int code) {
  code = 0;
  samples_regular = true;
  ivec3 corner = ivec3(int(candidate % 9u), int((candidate / 9u) % 9u), int(candidate / 81u));
  int scale = 1 << int(owner.level);
  ivec3 q = (owner.coord * 8 + corner) * scale;
  for (int c = 0; c < 8; ++c) {
    HierarchicalNode node;
    ivec3 query;
    uint si;
    if (!sampleStorage(owner, corner, q, c, node, query, si)) return false;
    samples_regular = samples_regular && node.level == owner.level;
    float w = weights[si];
    float d = tsdf[si];
    if (!(w >= pc.weight_threshold) || isnan(d) || isinf(d)) return false;
    int h = 1 << int(node.level);
    ivec3 lower = (query >> int(node.level)) * h;
    samples[c].lower = lower;
    samples[c].position = (vec3(lower) + vec3(float(h) * 0.5)) * pc.voxel_size;
    samples[c].distance = d;
    samples[c].color = vec3(1.0);
    if (need_color && pc.has_color != 0u) {
      uint color = colors[si];
      if (color != 0u) samples[c].color = vrUnpackSrgbToLinear(color);
    }
    if (d < pc.iso) code |= 1 << c;
  }
  return true;
}

void crossing(int edge, out vec3 position, out vec3 color) {
  int a = edge_to_vert[2 * edge];
  int b = edge_to_vert[2 * edge + 1];
  // The same snapped edge can occupy different local MC edges in neighboring
  // duals. Canonical actual-cell ordering, not local corner ordering, makes
  // interpolation bit-identical on both sides.
  if (coordLess(samples[b].lower, samples[a].lower)) {
    int tmp = a; a = b; b = tmp;
  }
  float ratio = mcEdgeRatio(samples[a].distance, samples[b].distance, pc.iso);
  position = mix(samples[a].position, samples[b].position, ratio);
  color = mix(samples[a].color, samples[b].color, ratio);
}

bool triangle(int code, int t, out vec3 p[3], out vec3 color[3]) {
  int base = code * 16 + t * 3;
  // Reverse the classic table's inward winding, as the uniform extractor does.
  crossing(tri_table[base], p[0], color[0]);
  crossing(tri_table[base + 2], p[1], color[1]);
  crossing(tri_table[base + 1], p[2], color[2]);
  if (all(equal(p[0], p[1])) || all(equal(p[1], p[2])) || all(equal(p[2], p[0]))) return false;
  vec3 area = cross(p[1] - p[0], p[2] - p[0]);
  return dot(area, area) > 0.0 && !any(isnan(area)) && !any(isinf(area));
}

// The usual eight-corner gradient is in parametric coordinates. Transform it
// by the dual cell's Jacobian: cross-level cells are generally not cubes.
// This also avoids unstable geometric normals on near-tangent sliver triangles.
vec3 dualNormal() {
  float sx = samples[1].distance + samples[2].distance + samples[5].distance + samples[6].distance -
             samples[0].distance - samples[3].distance - samples[4].distance - samples[7].distance;
  float sy = samples[2].distance + samples[3].distance + samples[6].distance + samples[7].distance -
             samples[0].distance - samples[1].distance - samples[4].distance - samples[5].distance;
  float sz = samples[4].distance + samples[5].distance + samples[6].distance + samples[7].distance -
             samples[0].distance - samples[1].distance - samples[2].distance - samples[3].distance;
  // Equal-level samples form a regular axis-aligned cube. Its Jacobian is a
  // positive scalar times identity, which cancels when the gradient normalizes.
  if (samples_regular) {
    vec3 gradient = vec3(sx, sy, sz);
    float squared = dot(gradient, gradient);
    if (!(squared > 0.0) || isinf(squared)) return vec3(0.0);
    return gradient * inversesqrt(squared);
  }
  vec3 dx = samples[1].position + samples[2].position + samples[5].position + samples[6].position -
            samples[0].position - samples[3].position - samples[4].position - samples[7].position;
  vec3 dy = samples[2].position + samples[3].position + samples[6].position + samples[7].position -
            samples[0].position - samples[1].position - samples[4].position - samples[5].position;
  vec3 dz = samples[4].position + samples[5].position + samples[6].position + samples[7].position -
            samples[0].position - samples[1].position - samples[2].position - samples[3].position;
  float determinant = dot(dx, cross(dy, dz));
  vec3 normal = cross(dy, dz) * sx + cross(dz, dx) * sy + cross(dx, dy) * sz;
  float squared = dot(normal, normal);
  if (determinant == 0.0 || !(squared > 0.0) || any(isnan(normal)) || any(isinf(normal))) return vec3(0.0);
  return normal * (sign(determinant) * inversesqrt(squared));
}

void main() {
  uint item = pc.leaf_base + gl_WorkGroupID.x;
  if (item >= pc.leaf_count) return;
  uint tid = gl_LocalInvocationID.x;
  uint id = leaves[item];
  if (id >= pc.node_capacity) {
    if (tid == 0u) atomicOr(rejected, 1u);
    return;
  }
  HierarchicalNode owner = vr_hierarchy_nodes[id];
  if (owner.children != 0u || owner.level > pc.max_level || owner.ptr < 0 ||
      owner.ptr % 512 != 0 || uint(owner.ptr) / 512u >= pc.node_capacity) {
    if (tid == 0u) atomicOr(rejected, 1u);
    return;
  }
  // Leave room for the +boundary vertex and the -1 incident-cell query;
  // reject before any signed multiply, including INT_MIN input coordinates.
  int limit = (2147483646 >> int(owner.level + 3u)) - 1;
  if (any(lessThan(owner.coord, ivec3(-limit))) || any(greaterThan(owner.coord, ivec3(limit)))) {
    if (tid == 0u) atomicOr(rejected, 1u);
    return;
  }
  if (tid == 0u) {
    tile_signs = 0u;
    block_count = 0u;
  }
  // Every adjacent region is aligned at the owner's level. It is covered by
  // one same/coarser leaf, or its level node is internal and all of its leaves
  // are finer, in which case this owner cannot emit an incident dual cell.
  // Resolve these 27 regions once, instead of traversing for each corner in
  // both the count and emission passes.
  if (tid < 27u) {
    ivec3 region = ivec3(int(tid % 3u), int((tid / 3u) % 3u), int(tid / 9u)) - ivec3(1);
    neighbor_valid[tid] = 0u;
    if (tid == 13u) {
      neighbor_nodes[tid] = owner;
      neighbor_valid[tid] = 1u;
    } else {
      VoxelGridParams grid = VoxelGridParams(0.0, 8, 512, 0.0, pc.bucket_size,
                                            pc.num_buckets, pc.num_buckets * pc.bucket_size, pc.max_chain);
      ivec3 query = (owner.coord + region) * (8 << int(owner.level));
      uint node_id;
      ivec3 local;
      if (vrHierarchyLocateAtLevel(query, grid, pc.max_level, pc.node_capacity,
                                    owner.level, node_id, local)) {
        HierarchicalNode node = vr_hierarchy_nodes[node_id];
        if (node.children == 0u &&
            (node.level > owner.level || !coordLess(node.coord, owner.coord))) {
          neighbor_nodes[tid] = node;
          neighbor_valid[tid] = 1u;
        }
      }
    }
  }
  barrier();
  // One shared SDF value for every owner-level cell in the [-1,8]^3 halo.
  // Accepted neighbors are same/coarser leaves, so querying the lower corner
  // of an owner-level cell addresses the same sample as q + shift - 1 in the
  // full gather. NaN represents absent, non-owned or unobserved samples.
  uint lane_signs = 0u;
  for (uint ti = tid; ti < 1000u; ti += 256u) {
    ivec3 local = ivec3(int(ti % 10u), int((ti / 10u) % 10u), int(ti / 100u)) - ivec3(1);
    ivec3 query = (owner.coord * 8 + local) * (1 << int(owner.level));
    HierarchicalNode node;
    uint si;
    float d = uintBitsToFloat(0x7fc00000u);
    if (sampleCellStorage(owner, local, query, node, si)) {
      float value = tsdf[si];
      if (weights[si] >= pc.weight_threshold && !isnan(value) && !isinf(value)) {
        d = value;
        lane_signs |= d < pc.iso ? 1u : 2u;
      }
    }
    sign_tile[ti] = d;
  }
  if (lane_signs != 0u) atomicOr(tile_signs, lane_signs);
  barrier();
  if (tile_signs != 3u) return;
  uint masks[3];
  uint count = 0u;
  for (uint k = 0u; k < 3u; ++k) {
    masks[k] = 0u;
    uint candidate = tid + k * 256u;
    if (candidate >= 729u) continue;
    int code;
    if (!cellSigns(candidate, code)) continue;
    if (!gather(owner, candidate, false, code)) continue;
    int n = mcCellTriangleCount(code);
    for (int t = 0; t < n; ++t) {
      vec3 p[3], color[3];
      if (triangle(code, t, p, color)) masks[k] |= 1u << uint(t);
    }
    count += bitCount(masks[k]);
  }
  // As in uniform extraction, only emitting lanes contribute. One shared
  // atomic per such lane avoids a full eight-barrier tree reduction.
  if (count != 0u) atomicAdd(block_count, count);
  barrier();
  if (block_count == 0u) return;
  if (tid == 0u) {
    block_base = atomicAdd(index_count, block_count * 3u) / 3u;
    block_cursor = 0u;
  }
  barrier();
  for (uint k = 0u; k < 3u; ++k) {
    if (masks[k] == 0u) continue;
    int code;
    if (!gather(owner, tid + k * 256u, true, code)) continue;
    vec3 gradient = dualNormal();
    uint first = block_base + atomicAdd(block_cursor, uint(bitCount(masks[k])));
    for (int t = 0; t < 5; ++t) {
      if ((masks[k] & (1u << uint(t))) == 0u) continue;
      uint tri = first++;
      if (tri >= pc.capacity) continue;
      vec3 p[3], color[3];
      triangle(code, t, p, color);
      vec3 normal = dot(gradient, gradient) > 0.0 ? gradient : normalize(cross(p[1] - p[0], p[2] - p[0]));
      for (uint v = 0u; v < 3u; ++v) {
        uint target = tri * 3u + v;
        mcWriteVertex(target, p[v], normal, color[v]);
        indices[target] = target;
      }
    }
  }
}
