#version 450

// Marching-cubes extraction straight off the sparse VoxelBlockGrid, with three
// PRIVATE vertices per triangle: one WORKGROUP per active block, striding over
// the block's voxels, where each voxel is the base corner of one marching-cubes
// cell. A cell whose base sits at a block's +face reaches its far corners into
// neighbouring blocks, so the block's 2x2x2 +neighbourhood (itself plus its
// seven +x/+y/+z neighbours, -1 when unallocated) is resolved into shared memory
// once per workgroup and read by every voxel.
//
// This is the DEFAULT kernel and what this tier has always done. Its sibling,
// marching_cubes_sparse_shared.comp, shares a vertex between the cells that meet
// on an edge; MarchingCubes::create builds exactly one of the two, chosen by
// MarchingCubesConfig::share_vertices. Two kernels rather than one with a push
// constant, because a `shared` array is reserved at pipeline creation whatever a
// push constant later says -- see the note in marching_cubes_sparse_common.glsl,
// which is where everything the two do identically lives.
//
// Because every triangle owns three consecutive vertices at `tri * 3`, the index
// run over this kernel's output IS the identity 0,1,2,...: the host fills it once
// per grow and MarchingCubes::download regenerates it rather than reading back.
//
// Emission is PER BLOCK: the block counts its triangles, reserves one span for
// all of them with a single global atomicAdd, and only then writes. So a block's
// triangles are contiguous in the arena instead of interleaved with every other
// block's, which is what a range can describe and therefore the precondition for
// meshing only the blocks a fuse changed. See the phase notes further down for
// what it costs (a second visit, cheaper than the first).
//
// It is resolved *here* rather than handed over by the host, which is what the
// workgroup-per-block shape exists for. The meshing dispatch is quiescent -- no
// concurrent allocation -- so a probe needs no bucket lock, and 8 probes amortise
// over voxels_per_block cells. The host-built table this replaced was an
// O(active_blocks * 8) serial pass of unordered_map lookups: measured at 102 ms
// of a 133 ms extract at 107k blocks on an M5 iPad Pro, against 26 ms for this
// kernel's own dispatch. Both prior CUDA and Metal implementations of this
// pipeline resolved neighbours on-device the same way.
//
// Only the corner sampling below differs from the dense kernel; the per-cell body
// (cube index, gradient normal, reversed-winding triangle emission, hybrid vertex
// colour) is the shared marching_cubes_common.glsl both kernels include.
//
// Voxels are node-centred (world = voxel * voxel_size), matching
// tsdf_integrate.comp and volume/voxel_coords.hpp, so the extracted surface
// aligns with the fused field. BlockIndex / Vertex are read/written through
// scalar block layout to match the host structs byte-for-byte (BlockIndex:
// ivec3 coord@0, ptr@12, 16 B; mesh Vertex: position@0, normal@12,
// tangent@24, uv0@40, color@48, 64 B).

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cross-tier: the one transfer curve, from core.
#include "volumetric_kit/recon/core/shaders/color_common.glsl"

// The per-block span record, shared with the sharing kernel. Included ahead of
// the buffer blocks below, which is why it cannot live in
// marching_cubes_sparse_common.glsl (that one reads `pc` and the attribute
// buffers, so it has to come after them).
#include "marching_cubes_block_span.glsl"

// One workgroup per block. 256 is fixed rather than sized from
// voxels_per_block, which is a push constant and so cannot set local_size
// without a specialization constant. That is exact at the default block_size 8
// (512 voxels = 2 cells per lane) and wasteful below it -- see the workgroup
// note in main().
layout(local_size_x = 256) in;

// The hash entries + the read-only traversal that resolves a neighbouring
// block's voxel-array base, which also supplies the shared BlockIndex /
// HashEntry layouts and hash constants from the volume tier's hash_common.glsl
// (one definition, not a mirror -- see hash_lookup.glsl).
#define VR_HASH_ENTRIES_BINDING 2
#include "volumetric_kit/recon/volume/shaders/hash_lookup.glsl"

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;  // renderer's slot; meshing has no parameterisation for one
  vec2 uv0;
  vec4 color;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];    // [256][16]
  int corner_offset[24];  // [8][3]
  int edge_to_vert[24];   // [12][2]
};
// The compacted active blocks -- one WORKGROUP per block, so the 2x2x2
// neighbourhood can be resolved once into shared memory and amortised over every
// voxel of the block (see s_neighbour in marching_cubes_sparse_common.glsl).
layout(set = 0, binding = 1, scalar) readonly buffer Active {
  BlockIndex active_blocks[];
};
// Binding 2 is the hash entries, declared by the hash_lookup.glsl include above.
// Per-voxel SDF + integration weight (the tsdf tier's attributes), addressed by
// BlockIndex::ptr + local. Color is the packed-RGB attribute (low three bytes,
// unpackUnorm4x8 -> .rgb) read only when pc.has_color != 0 (else a dummy binds).
layout(set = 0, binding = 3, scalar) readonly buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Color { uint color_attr[]; };
layout(set = 0, binding = 6, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
// The draw command's indexCount, which the kernel counts into directly -- one
// atomicAdd per block, in PHASE TWO below, of the whole block's count. The four
// fields after it are host-written once per extract and untouched here, as is
// `vertex_count` (only the sharing kernel allocates through it; here the vertex
// total is exactly three per triangle and the host derives it) and
// `sharing_applied` (only the sharing kernel reports it).
//
// Declared in full down to the one word this kernel does write. A struct that
// stopped at index_count could not name a later field, and naming it by byte
// offset is what the scalar-layout ABI exists to avoid.
layout(set = 0, binding = 7, scalar) buffer DrawCommand {
  uint index_count;
  uint instance_count;
  uint first_index;
  int vertex_offset;
  uint first_instance;
  uint vertex_count;     // the sharing kernel's; untouched here
  uint sharing_applied;  // the sharing kernel's; untouched here
  // Blocks this dispatch re-meshed, bumped once per re-meshing workgroup while
  // pc.incremental is set. The host has no way to derive it: the dilation from
  // the changed set to the re-mesh set happens below, off shared memory. Left
  // at the host's zero on a full pass, where the answer is num_active_blocks
  // and one atomic per workgroup to restate it is not free.
  uint remeshed_blocks;
};

// Where each block's output landed; see marching_cubes_block_span.glsl for the
// struct and why it is declared there. Binding 8 here, 9 in the sharing kernel.
// A 1-element dummy when pc.write_spans is 0, so the descriptor stays valid for
// a caller who did not ask for a table.
layout(set = 0, binding = 8, scalar) buffer BlockSpans {
  BlockSpan block_spans[];
};
// One flag per block slot, produced by the tsdf tier's opt-in dirty tracking and
// read here rather than taken back through the host. Bound only when
// pc.incremental != 0; a 1-element dummy otherwise, the color_dummy_ pattern.
//
// This is the CHANGED set, not the re-mesh set. A cell reads corners at
// `base + {0,1}^3`, so a block whose voxels changed invalidates the mesh of
// every block in its `{0,-1}^3` octant -- which, read from this end, is: this
// block re-meshes when any of its OWN `+{0,1}^3` neighbourhood is flagged. That
// neighbourhood is exactly `s_neighbour`, already resolved for the corner
// gather, so the dilation costs eight shared reads and no host pass. Doing it on
// the host instead would mean a readback, a set union and an upload, on the
// tier whose host-built table the 2026-08-08 decision deleted.
layout(set = 0, binding = 9, scalar) readonly buffer DirtyFlags {
  uint dirty_flags[];
};

layout(push_constant, scalar) uniform PushConstants {
  int block_size;          // voxels per block edge
  int voxels_per_block;    // block_size^3
  float voxel_size;        // metres between adjacent voxels
  float iso;               // iso-value to extract
  uint num_active_blocks;  // active_blocks length
  uint capacity;           // max triangles the index run holds
  float weight_threshold;  // corners below this weight invalidate the cell
  uint has_color;          // 0 = no color input; vertices get opaque white
  // Vertices the arena holds. Declared but UNUSED here, and that is deliberate:
  // this block is one ABI shared with marching_cubes_sparse_shared.comp and
  // SparsePushConstants on the host, so omitting a field would shift every
  // offset after it. This kernel needs no bound of its own -- it writes
  // `vertices[tri * 3 + k]` under `tri < capacity`, and the host keeps the two
  // budgets locked at exactly three vertices per triangle whenever sharing is
  // off (see ensure_output_buffers).
  uint vertex_capacity;
  // The hash-table shape, for the on-device neighbour probe. Passed rather than
  // read from a VoxelGridParams block because hash_common.glsl's `pc` would
  // collide with this one -- see hash_lookup.glsl.
  int num_buckets;
  int bucket_size;
  int max_chain;
  // 0 = the span binding is a 1-element dummy; do not store through it. Gates
  // MarchingCubesConfig::track_block_spans, the way has_color gates the colour
  // attribute.
  uint write_spans;
  // Re-mesh only the blocks whose neighbourhood a fuse changed, writing each
  // into the range it already owns. Appended at the END for the reason
  // write_spans is: this block is one ABI shared with the sharing kernel and
  // SparsePushConstants.
  uint incremental;
  // Slots `dirty_flags` addresses. A block past it is treated as dirty -- the
  // conservative direction, and it re-meshes rather than going stale.
  uint dirty_capacity;
  // Block slots the grid's heap holds, so a BlockIndex::ptr this kernel did not
  // produce can be bounded in one comparison. Appended at the END for the
  // reason dirty_capacity was: this block is one ABI shared with the sibling
  // sparse kernel and SparsePushConstants on the host.
  uint num_block_slots;
} pc;

// mcCornerShift / mcCellNormal / mcEdgeVertex / mcCellTriangleCount /
// mcWriteTriangle + the near-tangent edge guard, over the Tables / Vertices /
// DrawCommand bindings declared above. (mcEmitCell, the per-triangle appender,
// lives there too but is the DENSE kernel's; this one reserves a span per block
// and writes through mcWriteTriangle directly.)
#include "marching_cubes_common.glsl"

// localIndex / mcLocalBase / s_neighbour / mcResolveNeighbourhood /
// mcCornerStorage / mcGather / mcCellSigns -- everything this kernel and the
// sharing one do identically.
#include "marching_cubes_sparse_common.glsl"

// ---------------------------------------------------------------------------
// Per-block contiguous emission.
//
// The block counts its triangles, reserves ONE span for all of them with a
// single global atomicAdd, and only then writes -- instead of every triangle
// claiming its own slot. A block's triangles then land CONTIGUOUSLY. Under the
// per-triangle append they interleaved with every other block in flight, so a
// block's output was scattered the length of the arena and no range could
// describe it. Per-block ranges are the precondition for meshing only the blocks
// a fuse changed: without them there is nothing to leave in place.
//
// That is the ONLY thing it buys, and the first draft of this note claimed a
// second: that the three 64-byte vertex writes of a triangle now coalesce. They
// do not, because they already did -- the per-triangle append also wrote a
// triangle's vertices at `tri * 3, +1, +2` and interleaved only whole triangles.
// The per-VERTEX interleaving a vertex-sharing review measured as costing
// coalescing is in the sharing kernel, which this does not touch. Nor is the
// index run monotonic within a block: `s_cursor` still hands out slots in
// whatever order cells reach it. Measured on room0 at `--voxel 0.012`, Release,
// interleaved samples: the restructure COSTS ~10% on the extract dispatch
// (1.17 -> 1.28 ms). It is justified as the precondition and not as a speedup;
// see the 2026-08-09 incremental-extraction decision in DECISIONS.md, which
// also records what did and did not move that number.
//
// The cost is that a cell is visited twice, and the two visits are deliberately
// asymmetric so it is far less than twice the work:
//
//   PHASE ONE runs over 100% of cells and needs only the cube index, so it
//   gathers SIGNS ONLY (mcCellSigns) -- no sdf/colour array copy-out, no sRGB
//   decode -- and caches each cell's triangle count in one byte of a private
//   register.
//   PHASE THREE re-gathers in full, but only the ~8% of cells that actually
//   emit (the emit rate measured flat across a 4x resolution sweep); the other
//   ~92% are rejected on that byte, without touching memory of any kind.
// ---------------------------------------------------------------------------

// Triangles this block's cells produce, the block's first triangle slot, and the
// cursor handing out slots within the reserved span.
shared uint s_block_tris;
shared uint s_block_base;
// Does any block in this block's +{0,1}^3 neighbourhood carry a change? Set by
// the same eight lanes that resolve the neighbourhood, so the dilation is read
// off state the gather already needs.
shared uint s_dirty;
// The range this block held before this extract, and whether it may be reused.
// `s_reuse` is false on a first extract, after a topology change, and whenever
// the new count outgrows the old range -- each of which appends instead.
shared uint s_old_base;
shared uint s_old_count;
shared bool s_reuse;

// Cells this kernel can scan, and so the largest block it will mesh. Mirrors
// kMaxSharedCells in marching_cubes_sparse_shared.comp and the host constant of
// the same name in marching_cubes.cpp, which refuses a larger grid outright --
// this array would otherwise be indexed past its end.
const uint kMaxScanCells = 512u;

// Per-cell TRIANGLE OFFSET within the block's reserved span: the EXCLUSIVE
// prefix sum of every cell's triangle count, stored shifted by one so entry
// `local` is the offset of cell `local` and entry `local + 1` is one past its
// last triangle. So the difference of two adjacent entries is that cell's count,
// which is why nothing else stores one.
//
// This replaces an `atomicAdd(s_cursor, n)` that handed slots out in whatever
// order cells reached it. The mesh was correct either way -- every slot was
// inside the block's span -- but the ORDER was not reproducible: a block
// re-meshed to identical geometry could permute its own triangles inside its
// own range. That is invisible to a consumer reading the mesh, and fatal to one
// binding per-triangle state to the arena slot (the projective texture atlas),
// which needs `slot = f(cell, triangle-in-cell)` to hold across extracts.
//
// It also subsumes the private per-cell count cache this used to carry. The
// cache existed so phase three could reject the ~92% of cells that emit nothing
// without re-gathering, and the adjacent-entry difference answers that same
// question from the array the ordering already needs -- so the rejection stays
// one read, the cache's four-slot reach stops bounding anything, and a
// block_size past that reach is now REFUSED by the host rather than silently
// gathered twice (see ExtractTimings::uncached_cells_per_block, which is
// therefore always 0).
//
// The cost is real and is the reason this note is long: ~2 KiB of `shared` on
// the DEFAULT path, which the 2026-08-08 decision split from the sharing kernel
// precisely so it would not carry a threadgroup budget it did not use. 2 KiB is
// a different regime from that decision's 8 KiB -- 16 resident workgroups on
// Apple's ~32 KiB and 8 at Vulkan's guaranteed 16 KiB floor, against 3 and 1 --
// but it is not free, and it is spent on determinism rather than on speed.
shared uint s_cell_off[kMaxScanCells + 1u];

// Turn the per-cell counts in s_cell_off[1 ..] into the exclusive prefix sums
// described above, in place. Hillis-Steele over the block's own cell count
// rather than the array's capacity, so a smaller block pays fewer rounds.
//
// Every thread must reach every barrier, so the bounds tests gate the memory
// access and never the iteration. `tmp` is read before the write barrier and
// applied after it, which is what keeps a round from reading a neighbour's
// already-updated value.
void mcScanCellOffsets(uint tid, uint group_threads, uint vpb) {
  const uint kScanSlots = (kMaxScanCells + 1u + 255u) / 256u;
  uint tmp[kScanSlots];
  for (uint d = 1u; d <= vpb; d <<= 1u) {
    for (uint s = 0u; s < kScanSlots; ++s) {
      uint i = tid + s * group_threads;
      tmp[s] = (i <= vpb && i >= d) ? s_cell_off[i - d] : 0u;
    }
    barrier();
    for (uint s = 0u; s < kScanSlots; ++s) {
      uint i = tid + s * group_threads;
      if (i <= vpb && i >= d) {
        s_cell_off[i] += tmp[s];
      }
    }
    barrier();
  }
}

// Give back the triangles this block no longer occupies.
//
// Two cases, and both leave live geometry behind if skipped, because the draw
// covers the whole arena rather than a compacted list:
//   - reused a range and SHRANK: the tail past the new count still holds the
//     previous extract's triangles;
//   - RELOCATED, or emptied entirely: the whole old range does.
//
// Retired by writing three identical vertices -- a zero-area triangle, culled
// before rasterisation -- rather than by compacting the index run, which would
// need a prefix sum over every block and so a pass the host would have to
// drive. That costs 192 B per dead triangle against the 12 B it would take if
// this kernel owned its index run; it does not, and the run being the identity
// is what keeps the whole path free of host work. TODO(mesh): revisit if
// relocation turns out to be common rather than rare.
void mcRetireOldRange(uint tid, uint group_threads) {
  if (pc.incremental == 0u) {
    return;
  }
  // Both cases end at the old range's end; only the start differs -- a reuse
  // retires the tail it no longer fills, a relocation or an emptied block all
  // of it.
  uint dead_first = s_reuse ? s_block_base + s_block_tris : s_old_base;
  uint dead_end = s_old_base + s_old_count;
  for (uint tri = dead_first + tid; tri < dead_end; tri += group_threads) {
    if (tri >= pc.capacity) {
      break;
    }
    uint vbase = tri * 3u;
    mcWriteVertex(vbase + 0u, vec3(0.0), vec3(0.0, 0.0, 1.0), vec3(1.0));
    mcWriteVertex(vbase + 1u, vec3(0.0), vec3(0.0, 0.0, 1.0), vec3(1.0));
    mcWriteVertex(vbase + 2u, vec3(0.0), vec3(0.0, 0.0, 1.0), vec3(1.0));
  }
}

void main() {
  int bs = pc.block_size;
  uint vpb = uint(pc.voxels_per_block);
  // The workgroup's linear thread index, and its size. gl_LocalInvocationIndex
  // rather than gl_LocalInvocationID.x, and the full dimension product rather
  // than gl_WorkGroupSize.x, because the two agree only while local_size_y/z
  // are 1. That is true today (the emitted SPIR-V is `LocalSize 256 1 1`) and
  // nothing states it, so a later y/z dimension -- to cut the idle lanes noted
  // below -- would silently race 8*Ny*Nz writers onto the 8 s_neighbour slots
  // and re-mesh every voxel Ny*Nz times through the append atomic. Both forms
  // compile; only this one stays correct.
  uint tid = gl_LocalInvocationIndex;
  uint group_threads =
      gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;

  // One workgroup per block, NOT a flat voxel grid: shared memory is per
  // workgroup, so the neighbourhood can only be shared if every thread here
  // belongs to the same block.
  uint block_i = gl_WorkGroupID.x;
  if (block_i >= pc.num_active_blocks) {
    return;
  }
  BlockIndex block = active_blocks[block_i];

  // A caller-supplied active set can name a block slot this grid never handed
  // out: the host bounds the LIST LENGTH in O(1), but bounding every ptr is
  // O(count) of host work per frame, which the extract deliberately does not
  // spend. Left unbounded, a fabricated ptr is an out-of-bounds STORE into
  // block_spans below, not merely a read of the wrong voxels -- and
  // robustBufferAccess is enabled nowhere in this repo. The condition is
  // uniform across the workgroup (every thread reads the same `block`), so this
  // returns as a whole group and reaches no barrier divergently.
  if (block.ptr < 0 ||
      uint(block.ptr) / uint(pc.voxels_per_block) >= pc.num_block_slots) {
    return;
  }

  // Zero the reservation state alongside resolving the neighbourhood -- one
  // barrier opens both. s_block_base is zeroed here rather than only on the
  // path that reserves, so it is never read uninitialised.
  if (tid == 0u) {
    s_block_tris = 0u;
    s_block_base = 0u;
    s_dirty = 0u;
  }
  // The offset array is zeroed WHOLE, not just over [0, vpb]: the scan below
  // walks the block's cells, but entry 0 is the fixed zero an exclusive prefix
  // starts from and the tail past vpb must not carry a previous workgroup's
  // counts into a partial round. Three strided writes at the default shape.
  for (uint i = tid; i <= kMaxScanCells; i += group_threads) {
    s_cell_off[i] = 0u;
  }
  mcResolveNeighbourhood(block, tid);
  barrier();

  // Dilate the changed set into the re-mesh set, on the eight blocks
  // `s_neighbour` already holds. A neighbour that is unallocated (-1) cannot
  // have changed; one past `dirty_capacity` is treated as changed, which
  // re-meshes a block that might not need it rather than leaving it stale.
  if (pc.incremental != 0u && tid < 8u) {
    int nptr = s_neighbour[tid];
    if (nptr >= 0) {
      uint nslot = uint(nptr) / uint(pc.voxels_per_block);
      if (nslot >= pc.dirty_capacity || dirty_flags[nslot] != 0u) {
        atomicOr(s_dirty, 1u);
      }
    }
  }
  // The range this block held going in. Read by one lane under the same barrier
  // as the dilation, so both are visible together below.
  if (pc.incremental != 0u && tid == 0u) {
    BlockSpan prev = block_spans[uint(block.ptr) / uint(pc.voxels_per_block)];
    s_old_base = prev.triangle_base;
    s_old_count = prev.triangle_count;
  }
  barrier();

  // A clean block keeps every triangle it already has, at the offsets the span
  // table already names -- so this returns WITHOUT touching the arena, the
  // counters or its span. That is the whole of what incremental extraction
  // buys, and it is one branch because stage 2 made a block's output a range.
  //
  // Uniform across the workgroup (s_dirty is threadgroup state written before
  // the barrier above), and no barrier follows, so the early return is legal.
  if (pc.incremental != 0u && s_dirty == 0u) {
    return;
  }
  // Past the gate, so this counts blocks that are actually re-meshed -- the
  // number the whole trade is measured against. One atomic per surviving
  // workgroup, and only on an incremental pass: the blocks that reach here are
  // the small set, and a full pass would pay it for every block to report a
  // count the host already has.
  if (pc.incremental != 0u && tid == 0u) {
    atomicAdd(remeshed_blocks, 1u);
  }

  // PHASE ONE -- count, and record each cell's TRIANGLE COUNT for the scan.
  //
  // Signs only (mcCellSigns): this loop runs over every cell in the block, and
  // the count needs nothing but the cube index. Gathering in full here -- the
  // eight sdf values copied out of an `out float[8]`, and up to 24 sRGB decodes
  // for colours a count cannot use -- would be paid on 100% of cells to be
  // thrown away on ~92% of them.
  //
  // The COUNT is what is recorded, not the cube index it came from, and that is
  // deliberate: the count is both what the scan sums and what phase three's
  // rejection tests, where recording the cube index would make that rejection an
  // SSBO walk of `tri_table` on the ~92% of cells that emit nothing.
  //
  // Stride over the block's voxels rather than assuming one thread each: the
  // workgroup is a fixed 256 while voxels_per_block is block_size^3 from the
  // grid params, so this is correct for any block size instead of only 8 (512,
  // which would need a 512-thread workgroup and still break at 16).
  //
  // Correct at any block size, but not equally efficient at one. Only
  // voxels_per_block lanes ever enter this loop, so below block_size 8 most of
  // the group idles -- 192 of 256 at block_size 4, 248 of 256 at block_size 2 --
  // and the host's one-workgroup-per-block dispatch multiplies the group count
  // by 256/voxels_per_block, which lowers the reachable active-block count
  // against maxComputeWorkGroupCount[0] by the same factor (see the dispatch in
  // marching_cubes.cpp). Both costs are booked rather than paid down: sizing the
  // group from voxels_per_block needs a specialization constant plumbed through
  // ComputePipeline::create, and every in-tree caller uses block_size 8, where
  // this shape is a win. TODO(mesh): revisit if a consumer ships a smaller
  // block.
  uint mine = 0u;
  for (uint local = tid; local < vpb; local += group_threads) {
    int n = mcCellTriangleCount(mcCellSigns(bs, mcLocalBase(local, bs)));
    if (n != 0) {
      // Shifted by one: entry `local + 1` is cell `local`'s count going in and
      // one-past-its-last-triangle coming out of the scan, which is what makes
      // the exclusive prefix fall out of an inclusive one.
      //
      // Only the first chunk's counts are kept. A block with more cells than
      // the array holds re-derives each later chunk's in phase three (see the
      // chunk loop there); recording them here would need one array per chunk.
      if (local < kMaxScanCells) {
        s_cell_off[local + 1u] = uint(n);
      }
      mine += uint(n);
    }
  }
  if (mine != 0u) {
    atomicAdd(s_block_tris, mine);
  }
  barrier();

  // The counts become offsets. Uniform across the workgroup and barrier-bound,
  // so it sits between the two phases rather than inside either. Bounded by the
  // array rather than by the block, so an oversized block scans its first chunk
  // here and the rest as phase three reaches them.
  mcScanCellOffsets(tid, group_threads, min(vpb, kMaxScanCells));

  // PHASE TWO -- one atomic for the whole block.
  //
  // `index_count` is bumped by the block's FULL count whatever `capacity` holds,
  // so it still ends as kIndicesPerTriangle times the field's true triangle
  // total -- the contract the host refits against. Triangles past the arena are
  // simply not written, which is a stronger form of the old
  // count-but-drop: overflow can no longer make the reported total a lower bound
  // by abandoning a cell early, because the count is taken before any slot is.
  if (tid == 0u) {
    // Write into the range this block already owns when the new count fits it.
    // That is what makes the extract incremental in MEMORY as well as in work:
    // the arena stops growing by the whole surface every frame, and a clean
    // neighbour's triangles are never moved out from under a draw.
    //
    // It is also the operation that can be SEEN. An in-place write lands on
    // bytes an outstanding generation may still be drawing -- every index stays
    // in range and every vertex stays a real vertex, so it is not a memory
    // error, but a viewer can catch one block mid-update. Whether that is
    // acceptable is what running this on device answers; the fallback if it is
    // not is copy-on-write, which is strictly more machinery.
    s_reuse = pc.incremental != 0u && s_block_tris <= s_old_count;
    if (s_reuse) {
      s_block_base = s_old_base;
    } else if (s_block_tris != 0u) {
      s_block_base =
          atomicAdd(index_count, s_block_tris * kIndicesPerTriangle) /
          kIndicesPerTriangle;
    }
    // The block-to-range mapping stage 3 (dirty-only dispatch) re-meshes
    // against: `active_blocks[block_i]` owns triangles [s_block_base,
    // s_block_base + s_block_tris), and this line is the only place that is
    // known -- the atomic hands ranges out in workgroup arrival order rather
    // than block order, so the host cannot derive it.
    //
    // Published for every meshed block, including one that emits nothing:
    // "meshed and empty" is a different statement from "never meshed", and only
    // the host's anchor expresses the second. s_block_base is zero-initialised,
    // so an empty block records an empty span rather than a stale one.
    //
    // Written BEFORE the capacity guard below, which is deliberate and is why
    // the host retires the whole table on a failed extract: the counters carry
    // the block's full total whatever the arena holds, so a span written here
    // can name triangles a too-small arena never took. The successful retry
    // republishes every one of them.
    //
    // Assigned by NAME. `s_block_base` is a triangle index only because the
    // atomic result was divided by kIndicesPerTriangle above, and the vertex
    // fields are that same base scaled by three; positionally, nothing in the
    // four says which is which.
    if (pc.write_spans != 0u) {
      BlockSpan span;
      span.vertex_base = s_block_base * 3u;
      span.vertex_count = s_block_tris * 3u;
      span.triangle_base = s_block_base;
      span.triangle_count = s_block_tris;
      block_spans[uint(block.ptr) / uint(pc.voxels_per_block)] = span;
    }
  }
  barrier();

  // Nothing reserved, or the whole reservation lies past the arena. The second
  // is newly PROVABLE per block and worth proving: every slot this block hands
  // out is >= s_block_base, so if that is already past capacity not one
  // triangle of this block can be written, and the alternative is a full
  // re-gather per emitting cell to drop each triangle individually at the
  // bottom of the loop. That is the common case on a first extract and on every
  // refit, where the arena is planned at ~64 triangles per block against a
  // field that can emit ~1400. Both tests are uniform across the workgroup and
  // no barrier follows, so returning here is safe.
  if (s_block_tris == 0u || s_block_base >= pc.capacity) {
    // Retire FIRST, then leave. A block whose surface left it entirely reaches
    // here with nothing to emit and everything to give back -- and returning
    // straight out stranded its whole previous range, which the arena still
    // holds and the draw still covers. It read as ten extra triangles of a
    // sphere that had moved, which is exactly the shape of bug an incremental
    // extract exists to create: geometry nobody wrote this frame and nobody
    // erased either.
    mcRetireOldRange(tid, group_threads);
    return;
  }
  uint block_end = s_block_base + s_block_tris;

  // PHASE THREE -- emit into the reserved span, a chunk of cells at a time.
  //
  // ONE chunk at block_size 8, which is every in-tree caller: the loop runs
  // once, over the offsets phase one already scanned, and costs nothing a flat
  // loop would not. A block with more cells than the offset array holds walks
  // several chunks, re-deriving each later chunk's counts from `mcCellSigns`
  // and rescanning -- so those cells pay a second SIGNS gather (not a second
  // full gather, which is what the count cache this replaced cost them). That
  // shortfall is what ExtractTimings::uncached_cells_per_block reports, on the
  // same threshold it always did.
  //
  // `chunk_base` is the running triangle count of every earlier chunk, so a
  // cell's offset within the block is still exactly one number -- the array is
  // a window onto the prefix sum, not the whole of it.
  uint chunk_base = 0u;
  for (uint c0 = 0u; c0 < vpb; c0 += kMaxScanCells) {
    uint chunk_cells = min(kMaxScanCells, vpb - c0);
    if (c0 != 0u) {
      // Re-window the array onto this chunk. The leading barrier is what makes
      // the previous chunk's reads finish before these writes land on them.
      barrier();
      for (uint i = tid; i <= kMaxScanCells; i += group_threads) {
        s_cell_off[i] = 0u;
      }
      barrier();
      for (uint j = tid; j < chunk_cells; j += group_threads) {
        int n = mcCellTriangleCount(mcCellSigns(bs, mcLocalBase(c0 + j, bs)));
        if (n != 0) {
          s_cell_off[j + 1u] = uint(n);
        }
      }
      barrier();
      mcScanCellOffsets(tid, group_threads, chunk_cells);
    }

    for (uint j = tid; j < chunk_cells; j += group_threads) {
      uint local = c0 + j;
      // This cell's slice of the block's span, straight off the scan: where it
      // starts, and how many slots phase one reserved for it.
      uint cell_off = chunk_base + s_cell_off[j];
      uint budget = s_cell_off[j + 1u] - s_cell_off[j];
      // The cheap rejection, and the reason phase one records counts at all: a
      // cell with no triangles is skipped WITHOUT gathering its eight corners,
      // which is ~92% of them.
      if (budget == 0u) {
        continue;
      }
      ivec3 base = mcLocalBase(local, bs);
      float sdf[8];
      vec3 corner_color[8];
      int cube_index;
      if (!mcGather(bs, base, sdf, corner_color, cube_index)) {
        continue;
      }
      // Recomputed from the cube index just gathered rather than read back from
      // the scan, even though the counting pass summed the same number. The
      // scan entry is a RESERVATION; this is the count that must match the
      // `tri_table` row mcWriteTriangle is about to walk, and only a count
      // derived from this cube_index is guaranteed to. With the
      // all-inside/all-outside case already rejected on the reservation, it
      // costs one table read on the ~8% of cells that reach here.
      int n = mcCellTriangleCount(cube_index);
      if (n == 0) {
        continue;
      }
      // This cell's slots, at a FIXED offset rather than in arrival order,
      // which is the whole point of the scan: the same cell in the same block
      // lands on the same arena slots every extract, so per-triangle state
      // keyed by slot survives a re-mesh that did not change the triangulation.
      //
      // Clamped to the cell's own reservation, not merely to the block's span.
      // The two counts come from two different gathers -- mcCellSigns when the
      // offsets were built, mcGather here -- which is a convention the code
      // does not enforce, so a disagreement has to fail SAFE. Under the
      // arrival-order cursor it could only overrun the block, and `block_end`
      // caught that; a fixed offset can also overrun the NEXT CELL inside the
      // same block, which no block-level bound sees. `budget` is what closes
      // that, and `block_end` stays as the outer of the two.
      uint first = s_block_base + cell_off;
      uint emit = min(uint(n), budget);
      if (first + emit > block_end) {
        continue;
      }
      vec3 normal = mcCellNormal(sdf);
      for (uint t = 0u; t < emit; ++t) {
        uint tri = first + t;
        if (tri >= pc.capacity) {
          break;  // counted first, dropped here -- and `tri` only grows
        }
        mcWriteTriangle(cube_index, int(t), sdf, corner_color, vec3(0.0),
                        block.coord * bs + base, pc.voxel_size, normal, pc.iso,
                        pc.has_color, tri);
      }
    }

    // Carry this chunk's total into the next one's offsets. Read after the
    // emit loop and before the next chunk overwrites the array -- the refill's
    // leading barrier is what orders those two.
    chunk_base += s_cell_off[chunk_cells];
  }

  // PHASE FOUR -- give back what this block no longer occupies.
  mcRetireOldRange(tid, group_threads);
}
