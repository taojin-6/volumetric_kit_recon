#version 450

// Marching-cubes extraction straight off the sparse VoxelBlockGrid: one
// invocation per voxel of each active block (the same block iteration the tsdf
// integrator uses), where each voxel is the base corner of one marching-cubes
// cell. A cell whose base sits at a block's +face reaches its far corners into
// neighbouring blocks, so corner samples are fetched through a host-built 2x2x2
// neighbour lookup table (this block plus its seven +x/+y/+z neighbours, -1 when
// a neighbour is unallocated) rather than a device-side hash probe -- the
// meshing dispatch is quiescent (no concurrent allocation), so the host resolves
// the neighbourhood from the already-compacted active set and the kernel just
// indexes it. Only the corner sampling below differs from the dense kernel; the
// per-cell body (cube index, gradient normal, reversed-winding triangle
// emission, hybrid vertex colour) is the shared marching_cubes_common.glsl both
// kernels include.
//
// Voxels are node-centred (world = voxel * voxel_size), matching
// tsdf_integrate.comp and volume/voxel_coords.hpp, so the extracted surface
// aligns with the fused field. BlockIndex / Vertex are read/written through
// scalar block layout to match the host structs byte-for-byte (BlockIndex:
// ivec3 coord@0, ptr@12, 16 B; mesh Vertex: position@0, normal@12, color@24,
// uv0@40, 48 B).

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cross-tier: the one transfer curve, from core.
#include "volumetric_kit/recon/core/shaders/color_common.glsl"

layout(local_size_x = 256) in;

// One active block: its block coordinate + the base index of its voxel run in
// the attribute arrays (mirrors volume::BlockIndex).
struct BlockIndex {
  ivec3 coord;
  int ptr;
};

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;  // renderer's slot; meshing has no parameterisation for one
  vec2 uv0;
  vec4 color;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];    // [256][16]
  int corner_offset[24];  // [8][3]
  int edge_to_vert[24];   // [12][2]
};
// The compacted active blocks (one invocation group per block) and, parallel to
// it, each block's 2x2x2 neighbour pointers: neighbour_ptr[block * 8 + octant],
// octant = ox + 2*oy + 4*oz for ox/oy/oz in {0, 1}. A -1 pointer marks an
// unallocated neighbour (the cell is skipped).
layout(set = 0, binding = 1, scalar) readonly buffer Active {
  BlockIndex active_blocks[];
};
layout(set = 0, binding = 2, scalar) readonly buffer Neighbours {
  int neighbour_ptr[];
};
// Per-voxel SDF + integration weight (the tsdf tier's attributes), addressed by
// BlockIndex::ptr + local. Color is the packed-RGB attribute (low three bytes,
// unpackUnorm4x8 -> .rgb) read only when pc.has_color != 0 (else a dummy binds).
layout(set = 0, binding = 3, scalar) readonly buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Color { uint color_attr[]; };
layout(set = 0, binding = 6, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
layout(set = 0, binding = 7) // The draw command's indexCount, which the kernel counts into directly --
// see mcEmitCell. The rest of VkDrawIndexedIndirectCommand is host-written
// once per extract and untouched here.
buffer DrawCommand { uint index_count; };

layout(push_constant, scalar) uniform PushConstants {
  int block_size;          // voxels per block edge
  int voxels_per_block;    // block_size^3
  float voxel_size;        // metres between adjacent voxels
  float iso;               // iso-value to extract
  uint num_active_blocks;  // active_blocks length
  uint capacity;           // max triangles the vertex buffer holds
  float weight_threshold;  // corners below this weight invalidate the cell
  uint has_color;          // 0 = no color input; vertices get opaque white
} pc;

// Local voxel index within a block (x-fastest), matching the attribute layout
// BlockIndex::ptr + local the tsdf integrator writes.
int localIndex(ivec3 lc, int bs) {
  return lc.x + bs * (lc.y + bs * lc.z);
}

// mcCornerShift / mcCellNormal / mcEmitCell + the near-tangent edge guard, over
// the Tables / Vertices / Counter bindings declared above.
#include "marching_cubes_common.glsl"

void main() {
  int bs = pc.block_size;
  uint vpb = uint(pc.voxels_per_block);
  uint gid = gl_GlobalInvocationID.x;
  if (gid >= pc.num_active_blocks * vpb) {
    return;
  }
  uint block_i = gid / vpb;
  uint local = gid % vpb;
  BlockIndex block = active_blocks[block_i];

  // The cell base voxel, in this block's local frame (x-fastest, as tsdf wrote).
  ivec3 base = ivec3(int(local % uint(bs)), int((local / uint(bs)) % uint(bs)),
                     int(local / uint(bs * bs)));

  // Gather the eight corners. A corner at local coordinate bs on an axis spills
  // into the +neighbour block on that axis: octant selects which of the 2x2x2
  // neighbourhood holds it, and the residual (coord % bs) indexes within it. A
  // corner in an unallocated neighbour (ptr < 0) or an unintegrated voxel
  // (weight below threshold) drops the whole cell -- no extrapolation.
  float sdf[8];
  vec3 corner_color[8];
  int cube_index = 0;
  for (int i = 0; i < 8; ++i) {
    ivec3 c = base + mcCornerShift(i);  // 0..bs per axis
    ivec3 octant = c / bs;              // 0 or 1 per axis (c <= bs)
    ivec3 lc = c - octant * bs;         // residual within the neighbour block
    int oi = octant.x + 2 * octant.y + 4 * octant.z;
    int nptr = neighbour_ptr[block_i * 8u + uint(oi)];
    if (nptr < 0) {
      return;  // neighbour block not allocated: no surface to close here
    }
    uint si = uint(nptr) + uint(localIndex(lc, bs));
    if (weight[si] < pc.weight_threshold) {
      return;  // unintegrated voxel
    }
    sdf[i] = tsdf[si];
    if (pc.has_color != 0u) {
      // color_attr == 0 is the tsdf integrator's "colour never observed"
      // sentinel: a fused colour is packed with alpha 0xFF (packUnorm4x8 of
      // vec4(rgb, 1.0)), so any observed colour is non-zero. A depth-integrated
      // but colour-unobserved corner (weight > 0, colour 0 -- a separate colour
      // camera, or a depth-only warmup) falls back to opaque white rather than
      // dragging the interpolated vertex toward black, mirroring the
      // integrator's first-observation-assigns anti-darkening rule.
      // Decoded to LINEAR working values here, because mcEmitCell interpolates
      // them along the cell edge and an interpolation is an average (the
      // 2026-08-02 decision). The white fallback is 1.0 in either space, so the
      // sentinel branch is unchanged by that.
      uint packed = color_attr[si];
      corner_color[i] = packed != 0u ? vrUnpackSrgbToLinear(packed) : vec3(1.0);
    }
    if (sdf[i] < pc.iso) {
      cube_index |= (1 << i);
    }
  }
  if (cube_index == 0 || cube_index == 255) {
    return;  // no sign change -> no surface in this cell
  }

  // World positions anchor on the base block's global voxel with a zero origin
  // (node convention), so a boundary cell's far corners land at the neighbour's
  // voxels without a second coord lookup. The shared body computes the gradient
  // normal, reverses winding, and interpolates colour.
  ivec3 base_voxel = block.coord * bs + base;
  vec3 normal = mcCellNormal(sdf);
  mcEmitCell(cube_index, sdf, corner_color, vec3(0.0), base_voxel, pc.voxel_size,
             normal, pc.iso, pc.has_color, pc.capacity);
}
