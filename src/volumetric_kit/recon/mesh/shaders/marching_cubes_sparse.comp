#version 450

// Marching-cubes extraction straight off the sparse VoxelBlockGrid, with three
// PRIVATE vertices per triangle: one WORKGROUP per active block, striding over
// the block's voxels, where each voxel is the base corner of one marching-cubes
// cell. A cell whose base sits at a block's +face reaches its far corners into
// neighbouring blocks, so the block's 2x2x2 +neighbourhood (itself plus its
// seven +x/+y/+z neighbours, -1 when unallocated) is resolved into shared memory
// once per workgroup and read by every voxel.
//
// This is the DEFAULT kernel and what this tier has always done. Its sibling,
// marching_cubes_sparse_shared.comp, shares a vertex between the cells that meet
// on an edge; MarchingCubes::create builds exactly one of the two, chosen by
// MarchingCubesConfig::share_vertices. Two kernels rather than one with a push
// constant, because a `shared` array is reserved at pipeline creation whatever a
// push constant later says -- see the note in marching_cubes_sparse_common.glsl,
// which is where everything the two do identically lives.
//
// Because every triangle owns three consecutive vertices at `tri * 3`, the index
// run over this kernel's output IS the identity 0,1,2,...: the host fills it once
// per grow and MarchingCubes::download regenerates it rather than reading back.
//
// Emission is PER BLOCK: the block counts its triangles, reserves one span for
// all of them with a single global atomicAdd, and only then writes. So a block's
// triangles are contiguous in the arena instead of interleaved with every other
// block's, which is what a range can describe and therefore the precondition for
// meshing only the blocks a fuse changed. See the phase notes further down for
// what it costs (a second visit, cheaper than the first).
//
// It is resolved *here* rather than handed over by the host, which is what the
// workgroup-per-block shape exists for. The meshing dispatch is quiescent -- no
// concurrent allocation -- so a probe needs no bucket lock, and 8 probes amortise
// over voxels_per_block cells. The host-built table this replaced was an
// O(active_blocks * 8) serial pass of unordered_map lookups: measured at 102 ms
// of a 133 ms extract at 107k blocks on an M5 iPad Pro, against 26 ms for this
// kernel's own dispatch. Both prior CUDA and Metal implementations of this
// pipeline resolved neighbours on-device the same way.
//
// Only the corner sampling below differs from the dense kernel; the per-cell body
// (cube index, gradient normal, reversed-winding triangle emission, hybrid vertex
// colour) is the shared marching_cubes_common.glsl both kernels include.
//
// Voxels are node-centred (world = voxel * voxel_size), matching
// tsdf_integrate.comp and volume/voxel_coords.hpp, so the extracted surface
// aligns with the fused field. BlockIndex / Vertex are read/written through
// scalar block layout to match the host structs byte-for-byte (BlockIndex:
// ivec3 coord@0, ptr@12, 16 B; mesh Vertex: position@0, normal@12,
// tangent@24, uv0@40, color@48, 64 B).

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cross-tier: the one transfer curve, from core.
#include "volumetric_kit/recon/core/shaders/color_common.glsl"

// One workgroup per block. 256 is fixed rather than sized from
// voxels_per_block, which is a push constant and so cannot set local_size
// without a specialization constant. That is exact at the default block_size 8
// (512 voxels = 2 cells per lane) and wasteful below it -- see the workgroup
// note in main().
layout(local_size_x = 256) in;

// The hash entries + the read-only traversal that resolves a neighbouring
// block's voxel-array base, which also supplies the shared BlockIndex /
// HashEntry layouts and hash constants from the volume tier's hash_common.glsl
// (one definition, not a mirror -- see hash_lookup.glsl).
#define VR_HASH_ENTRIES_BINDING 2
#include "volumetric_kit/recon/volume/shaders/hash_lookup.glsl"

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;  // renderer's slot; meshing has no parameterisation for one
  vec2 uv0;
  vec4 color;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];    // [256][16]
  int corner_offset[24];  // [8][3]
  int edge_to_vert[24];   // [12][2]
};
// The compacted active blocks -- one WORKGROUP per block, so the 2x2x2
// neighbourhood can be resolved once into shared memory and amortised over every
// voxel of the block (see s_neighbour in marching_cubes_sparse_common.glsl).
layout(set = 0, binding = 1, scalar) readonly buffer Active {
  BlockIndex active_blocks[];
};
// Binding 2 is the hash entries, declared by the hash_lookup.glsl include above.
// Per-voxel SDF + integration weight (the tsdf tier's attributes), addressed by
// BlockIndex::ptr + local. Color is the packed-RGB attribute (low three bytes,
// unpackUnorm4x8 -> .rgb) read only when pc.has_color != 0 (else a dummy binds).
layout(set = 0, binding = 3, scalar) readonly buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Color { uint color_attr[]; };
layout(set = 0, binding = 6, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
// The draw command's indexCount, which the kernel counts into directly -- one
// atomicAdd per block, in PHASE TWO below, of the whole block's count. The rest
// of VkDrawIndexedIndirectCommand is host-written once per
// extract and untouched here, as is the vertex counter the host keeps at byte 20
// (only the sharing kernel allocates through it; here the vertex total is
// exactly three per triangle and the host derives it).
layout(set = 0, binding = 7, scalar) buffer DrawCommand { uint index_count; };

layout(push_constant, scalar) uniform PushConstants {
  int block_size;          // voxels per block edge
  int voxels_per_block;    // block_size^3
  float voxel_size;        // metres between adjacent voxels
  float iso;               // iso-value to extract
  uint num_active_blocks;  // active_blocks length
  uint capacity;           // max triangles the index run holds
  float weight_threshold;  // corners below this weight invalidate the cell
  uint has_color;          // 0 = no color input; vertices get opaque white
  // Vertices the arena holds. Declared but UNUSED here, and that is deliberate:
  // this block is one ABI shared with marching_cubes_sparse_shared.comp and
  // SparsePushConstants on the host, so omitting a field would shift every
  // offset after it. This kernel needs no bound of its own -- it writes
  // `vertices[tri * 3 + k]` under `tri < capacity`, and the host keeps the two
  // budgets locked at exactly three vertices per triangle whenever sharing is
  // off (see ensure_output_buffers).
  uint vertex_capacity;
  // The hash-table shape, for the on-device neighbour probe. Passed rather than
  // read from a VoxelGridParams block because hash_common.glsl's `pc` would
  // collide with this one -- see hash_lookup.glsl.
  int num_buckets;
  int bucket_size;
  int max_chain;
} pc;

// mcCornerShift / mcCellNormal / mcEdgeVertex / mcCellTriangleCount /
// mcWriteTriangle + the near-tangent edge guard, over the Tables / Vertices /
// DrawCommand bindings declared above. (mcEmitCell, the per-triangle appender,
// lives there too but is the DENSE kernel's; this one reserves a span per block
// and writes through mcWriteTriangle directly.)
#include "marching_cubes_common.glsl"

// localIndex / mcLocalBase / s_neighbour / mcResolveNeighbourhood /
// mcCornerStorage / mcGather / mcCellSigns -- everything this kernel and the
// sharing one do identically.
#include "marching_cubes_sparse_common.glsl"

// ---------------------------------------------------------------------------
// Per-block contiguous emission.
//
// The block counts its triangles, reserves ONE span for all of them with a
// single global atomicAdd, and only then writes -- instead of every triangle
// claiming its own slot. A block's triangles then land CONTIGUOUSLY. Under the
// per-triangle append they interleaved with every other block in flight, so a
// block's output was scattered the length of the arena and no range could
// describe it. Per-block ranges are the precondition for meshing only the blocks
// a fuse changed: without them there is nothing to leave in place.
//
// That is the ONLY thing it buys, and the first draft of this note claimed a
// second: that the three 64-byte vertex writes of a triangle now coalesce. They
// do not, because they already did -- the per-triangle append also wrote a
// triangle's vertices at `tri * 3, +1, +2` and interleaved only whole triangles.
// The per-VERTEX interleaving a vertex-sharing review measured as costing
// coalescing is in the sharing kernel, which this does not touch. Nor is the
// index run monotonic within a block: `s_cursor` still hands out slots in
// whatever order cells reach it. Measured, the restructure COSTS ~13% on the
// extract dispatch. It is justified as the precondition and not as a speedup;
// see the 2026-08-09 incremental-extraction decision in DECISIONS.md.
//
// The cost is that a cell is visited twice, and the two visits are deliberately
// asymmetric so it is far less than twice the work:
//
//   PHASE ONE runs over 100% of cells and needs only the cube index, so it
//   gathers SIGNS ONLY (mcCellSigns) -- no sdf/colour array copy-out, no sRGB
//   decode -- and caches each cell's triangle count in one byte.
//   PHASE THREE re-gathers in full, but only the ~8% of cells that actually
//   emit (the emit rate measured flat across a 4x resolution sweep); the other
//   ~92% are rejected on a shared-memory byte.
// ---------------------------------------------------------------------------

// Triangles this block's cells produce, the block's first triangle slot, and the
// cursor handing out slots within the reserved span.
shared uint s_block_tris;
shared uint s_block_base;
shared uint s_cursor;

// Per-cell TRIANGLE COUNT, cached between the two phases so phase three can
// reject a cell without re-gathering its eight corners -- and, since the count
// is what the rejection tests, without walking `tri_table` either. Caching the
// cube index instead would make the rejection an SSBO read on the ~92% of cells
// that emit nothing, which is the path that has to be cheap.
//
// A count is 0..5, so it is one byte, packed four to a uint: 512 B for the
// default block_size 8, against the ~8 KiB of `shared` the vertex-sharing kernel
// needs. Keeping it small matters *here* and not there, because this is the
// DEFAULT kernel -- the 2026-08-08 decision split the two precisely so the
// default path would not carry sharing's threadgroup budget, and a two-phase
// emitter must not reintroduce it by the back door.
//
// A block with more cells than this still meshes correctly: phase three
// re-gathers the uncached tail (see the loop below), which is slower but not
// wrong. Every in-tree caller uses block_size 8, where nothing is uncached.
//
// Slower, and by enough to matter -- at block_size 16 87.5% of a block's cells
// fall past the cache and are gathered in FULL twice, so the ~1.08 gathers per
// cell this design is chosen for becomes ~1.88. Nothing about that is visible
// from a correct-looking mesh, so the host mirrors this constant
// (kMaxCachedCells in marching_cubes.cpp) and reports the shortfall as
// ExtractTimings::uncached_cells_per_block: a limit the caller cannot see is
// the library's to check, not to document (the 2026-08-04 decision). It is a
// REPORT and not a refusal, unlike the sharing kernel's identically-valued
// kMaxSharedCells -- there an oversized block would index past a shared array,
// here it only costs time.
const uint kMaxCachedCells = 512u;
const uint kCacheWords = kMaxCachedCells / 4u;
shared uint s_tri_cache[kCacheWords];

// Cache / read a cell's triangle count. atomicOr because adjacent cells share a
// word and are handled by different threads; the words are zeroed before the
// barrier that opens phase one, so an OR is enough to place a byte.
//
// Called only for a NONZERO count. The word starts zeroed and the byte is
// already 0, so ORing a zero is bit-identical to skipping it -- and it is the
// ~92% case, four lanes of every SIMD group contending on one word to write
// nothing.
void mcCacheTriCount(uint local, int n) {
  atomicOr(s_tri_cache[local >> 2u], uint(n) << ((local & 3u) * 8u));
}

uint mcCachedTriCount(uint local) {
  return (s_tri_cache[local >> 2u] >> ((local & 3u) * 8u)) & 0xFFu;
}

void main() {
  int bs = pc.block_size;
  uint vpb = uint(pc.voxels_per_block);
  // The workgroup's linear thread index, and its size. gl_LocalInvocationIndex
  // rather than gl_LocalInvocationID.x, and the full dimension product rather
  // than gl_WorkGroupSize.x, because the two agree only while local_size_y/z
  // are 1. That is true today (the emitted SPIR-V is `LocalSize 256 1 1`) and
  // nothing states it, so a later y/z dimension -- to cut the idle lanes noted
  // below -- would silently race 8*Ny*Nz writers onto the 8 s_neighbour slots
  // and re-mesh every voxel Ny*Nz times through the append atomic. Both forms
  // compile; only this one stays correct.
  uint tid = gl_LocalInvocationIndex;
  uint group_threads =
      gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;

  // One workgroup per block, NOT a flat voxel grid: shared memory is per
  // workgroup, so the neighbourhood can only be shared if every thread here
  // belongs to the same block.
  uint block_i = gl_WorkGroupID.x;
  if (block_i >= pc.num_active_blocks) {
    return;
  }
  BlockIndex block = active_blocks[block_i];

  // Zero the reservation state and the triangle-count cache before any
  // phase-one thread ORs into it, alongside resolving the neighbourhood -- one
  // barrier opens all three. s_block_base is zeroed here rather than only on
  // the path that reserves, so it is never read uninitialised.
  if (tid == 0u) {
    s_block_tris = 0u;
    s_block_base = 0u;
    s_cursor = 0u;
  }
  for (uint w = tid; w < kCacheWords; w += group_threads) {
    s_tri_cache[w] = 0u;
  }
  mcResolveNeighbourhood(block, tid);
  barrier();

  // PHASE ONE -- count, and cache each cell's TRIANGLE COUNT for phase three.
  //
  // Signs only (mcCellSigns): this loop runs over every cell in the block, and
  // the count needs nothing but the cube index. Gathering in full here -- the
  // eight sdf values copied out of an `out float[8]`, and up to 24 sRGB decodes
  // for colours a count cannot use -- would be paid on 100% of cells to be
  // thrown away on ~92% of them.
  //
  // The COUNT is what is cached, not the cube index it came from, and that is
  // deliberate: the count is what phase three's rejection tests, so caching it
  // makes that rejection a shared-memory read, where caching the cube index
  // would make it an SSBO walk of `tri_table` on the ~92% of cells that emit
  // nothing. It also fits in one byte (0..5) where a cube index needs two.
  //
  // Stride over the block's voxels rather than assuming one thread each: the
  // workgroup is a fixed 256 while voxels_per_block is block_size^3 from the
  // grid params, so this is correct for any block size instead of only 8 (512,
  // which would need a 512-thread workgroup and still break at 16).
  //
  // Correct at any block size, but not equally efficient at one. Only
  // voxels_per_block lanes ever enter this loop, so below block_size 8 most of
  // the group idles -- 192 of 256 at block_size 4, 248 of 256 at block_size 2 --
  // and the host's one-workgroup-per-block dispatch multiplies the group count
  // by 256/voxels_per_block, which lowers the reachable active-block count
  // against maxComputeWorkGroupCount[0] by the same factor (see the dispatch in
  // marching_cubes.cpp). Both costs are booked rather than paid down: sizing the
  // group from voxels_per_block needs a specialization constant plumbed through
  // ComputePipeline::create, and every in-tree caller uses block_size 8, where
  // this shape is a win. TODO(mesh): revisit if a consumer ships a smaller
  // block.
  uint mine = 0u;
  for (uint local = tid; local < vpb; local += group_threads) {
    int n = mcCellTriangleCount(mcCellSigns(bs, mcLocalBase(local, bs)));
    if (n != 0) {
      if (local < kMaxCachedCells) {
        mcCacheTriCount(local, n);
      }
      mine += uint(n);
    }
  }
  if (mine != 0u) {
    atomicAdd(s_block_tris, mine);
  }
  barrier();

  // PHASE TWO -- one atomic for the whole block.
  //
  // `index_count` is bumped by the block's FULL count whatever `capacity` holds,
  // so it still ends as kIndicesPerTriangle times the field's true triangle
  // total -- the contract the host refits against. Triangles past the arena are
  // simply not written, which is a stronger form of the old
  // count-but-drop: overflow can no longer make the reported total a lower bound
  // by abandoning a cell early, because the count is taken before any slot is.
  // TODO(mesh): stage 3 (dirty-only dispatch) needs the block-to-range mapping
  // this line computes and drops -- `active_blocks[block_i]` owns triangles
  // [s_block_base, s_block_base + s_block_tris). It is not derivable on the
  // host, because the atomic hands spans out in workgroup arrival order rather
  // than block order. Publishing it is a ninth binding, a host allocation and a
  // DeviceMesh field, which is stage 3's scope and not this one's: stage 2 is
  // defined as byte-identical geometry with no new invariants (the 2026-08-09
  // decision), and a range nothing consumes yet would be an unverifiable one.
  if (tid == 0u && s_block_tris != 0u) {
    s_block_base =
        atomicAdd(index_count, s_block_tris * kIndicesPerTriangle) /
        kIndicesPerTriangle;
  }
  barrier();

  // Nothing reserved, or the whole reservation lies past the arena. The second
  // is newly PROVABLE per block and worth proving: every slot this block hands
  // out is >= s_block_base, so if that is already past capacity not one
  // triangle of this block can be written, and the alternative is a full
  // re-gather per emitting cell to drop each triangle individually at the
  // bottom of the loop. That is the common case on a first extract and on every
  // refit, where the arena is planned at ~64 triangles per block against a
  // field that can emit ~1400. Both tests are uniform across the workgroup and
  // no barrier follows, so returning here is safe.
  if (s_block_tris == 0u || s_block_base >= pc.capacity) {
    return;
  }
  uint block_end = s_block_base + s_block_tris;

  // PHASE THREE -- emit into the reserved span.
  for (uint local = tid; local < vpb; local += group_threads) {
    // The cheap rejection, and the reason phase one caches at all: a cell with
    // no triangles is skipped WITHOUT gathering its eight corners, which is
    // ~92% of them. Cells past the cache fall through and gather.
    if (local < kMaxCachedCells && mcCachedTriCount(local) == 0u) {
      continue;
    }
    ivec3 base = mcLocalBase(local, bs);
    float sdf[8];
    vec3 corner_color[8];
    int cube_index;
    if (!mcGather(bs, base, sdf, corner_color, cube_index)) {
      continue;
    }
    // Recomputed from the cube index just gathered rather than read back from
    // the cache, even though phase one put the same number there. The cache is
    // a REJECTION HINT; this is the count that must match the `tri_table` row
    // mcWriteTriangle is about to walk, and only a count derived from this
    // cube_index is guaranteed to. With the all-inside/all-outside case already
    // rejected on a register, it costs one table read on the ~8% of cells that
    // reach here.
    int n = mcCellTriangleCount(cube_index);
    if (n == 0) {
      continue;
    }
    // Slots within this block's span. The cursor is shared, so the order cells
    // land in is still unspecified -- but every slot it hands out is inside the
    // span, because the span was sized from the same counts.
    //
    // "The same counts" is a convention between two different gathers --
    // mcCellSigns in phase one, mcGather here -- and not something the code
    // enforces, so this bound is what makes a disagreement between them fail
    // SAFE. Without it a span that overran would write over the next block's
    // triangles, with a correct-looking indexCount and no error anywhere: the
    // per-triangle append this replaced could not overrun by construction,
    // because counting and writing were one act, and that guarantee has to be
    // paid for somewhere.
    uint first = s_block_base + atomicAdd(s_cursor, uint(n));
    if (first + uint(n) > block_end) {
      continue;
    }
    vec3 normal = mcCellNormal(sdf);
    for (int t = 0; t < n; ++t) {
      uint tri = first + uint(t);
      if (tri >= pc.capacity) {
        break;  // counted in phase one, dropped here -- and `tri` only grows
      }
      mcWriteTriangle(cube_index, t, sdf, corner_color, vec3(0.0),
                      block.coord * bs + base, pc.voxel_size, normal, pc.iso,
                      pc.has_color, tri);
    }
  }
}
