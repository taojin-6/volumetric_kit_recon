#version 450

// Marching-cubes extraction off the sparse VoxelBlockGrid with IN-BLOCK VERTEX
// SHARING: the cells that meet on an edge index one vertex instead of emitting
// three private ones each. Same surface, same triangles, ~4x fewer vertices.
//
// The sibling of marching_cubes_sparse.comp, which is the default and shares
// nothing. MarchingCubes::create builds exactly one of the two, chosen by
// MarchingCubesConfig::share_vertices -- two kernels rather than one with a push
// constant, because the `shared` arrays below are reserved at pipeline creation
// whatever a push constant later says. Everything the two do identically (the
// neighbourhood probe, the corner gather, the block addressing) is
// marching_cubes_sparse_common.glsl; the per-cell numerics are
// marching_cubes_common.glsl, which the dense kernel also includes.
//
// FOUR passes over the block's cells. The block counts what it will produce,
// reserves ONE vertex range and ONE triangle range with a single atomicAdd each,
// and only then writes -- so its output is contiguous in both buffers instead of
// interleaved with every other block in flight, which is what a per-block range
// can describe and therefore the precondition for meshing only the blocks a fuse
// changed. Two ranges rather than the default kernel's one, because a shared
// vertex breaks `v = 3t`.
//
//   1. mcCountCell -- classify (gather once, into `s_case`) and count the
//      vertices this cell OWNS and the triangles it will emit.
//   2. mcCountDuplicates -- count the vertices it will DUPLICATE. Separate
//      because a duplicate is decided by the OWNER cell's state, which pass 1 is
//      still writing.
//   3. mcOwnedEdgePass -- emit a vertex on each of the three edges the cell OWNS
//      (+x/+y/+z from its base corner). Every edge in the field is owned by
//      exactly one cell (mcEdgeOwner), so after this pass every in-block edge
//      carrying a crossing has exactly one vertex.
//   4. mcTrianglePass -- emit the cell's triangles as indices into those
//      vertices. An edge whose owner lies outside the block (the +face), or
//      whose owner is invalid, is DUPLICATED inline -- which is why the saving
//      is ~4x rather than the ~6x full sharing would give.
//
// Counting costs one extra gather of the cells that actually produce something
// (~8% of them): passes 3 and 4 read pass 1's `s_case` and re-gather only those.
//
// Unlike the default kernel, the index run here is NOT the identity: a vertex is
// referenced by several triangles from several cells and only this kernel knows
// which, so it writes the real indices and MarchingCubes::download reads them
// back.

#extension GL_EXT_scalar_block_layout : require
#extension GL_GOOGLE_include_directive : require

// Cross-tier: the one transfer curve, from core.
#include "volumetric_kit/recon/core/shaders/color_common.glsl"

// One workgroup per block. 256 is fixed rather than sized from
// voxels_per_block, which is a push constant and so cannot set local_size
// without a specialization constant. That is exact at the default block_size 8
// (512 voxels = 2 cells per lane) and wasteful below it -- see the workgroup
// note in main().
layout(local_size_x = 256) in;

// The hash entries + the read-only traversal that resolves a neighbouring
// block's voxel-array base, which also supplies the shared BlockIndex /
// HashEntry layouts and hash constants from the volume tier's hash_common.glsl
// (one definition, not a mirror -- see hash_lookup.glsl).
#define VR_HASH_ENTRIES_BINDING 2
#include "volumetric_kit/recon/volume/shaders/hash_lookup.glsl"

// One mesh vertex (mirrors mesh::Vertex).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;  // renderer's slot; meshing has no parameterisation for one
  vec2 uv0;
  vec4 color;
};

// The marching-cubes tables (mirrors mesh::McTables): the flattened 256x16
// triangle table, the 8 corner offsets, and the 12 edge-endpoint pairs.
layout(set = 0, binding = 0, scalar) readonly buffer Tables {
  int tri_table[4096];    // [256][16]
  int corner_offset[24];  // [8][3]
  int edge_to_vert[24];   // [12][2]
};
// The compacted active blocks -- one WORKGROUP per block, so the 2x2x2
// neighbourhood and the owned-edge table can be shared across the block.
layout(set = 0, binding = 1, scalar) readonly buffer Active {
  BlockIndex active_blocks[];
};
// Binding 2 is the hash entries, declared by the hash_lookup.glsl include above.
layout(set = 0, binding = 3, scalar) readonly buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 4, scalar) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 5, scalar) readonly buffer Color { uint color_attr[]; };
layout(set = 0, binding = 6, scalar) writeonly buffer Vertices {
  Vertex vertices[];
};
// The draw command, plus two words of recon scratch past it.
//
// `index_count` IS VkDrawIndexedIndirectCommand::indexCount -- the kernel counts
// into the command rather than into a number a host would build one from. The
// three middle fields are host-written once per extract and untouched here.
//
// `vertex_count` sits at byte 20, immediately AFTER the 20-byte command, so the
// vertex allocator needs no second buffer, no second binding and no second
// per-slot allocation -- and `vkCmdDrawIndexedIndirect` still reads a
// well-formed command at offset 0, which is all a consumer binds. It cannot be
// derived from `index_count`: that was only ever true because every triangle
// owned three private vertices, which is precisely what this kernel stops doing.
//
// `sharing_applied` at byte 24 is this kernel telling the host it really did
// share. kMaxSharedCells below is a compile-time GLSL constant mirrored by a
// host constant that gates the refusal, and nothing else ties the two together;
// raising the host's alone would admit a block this kernel then meshes UNSHARED,
// silently losing the feature the caller asked for. The host reads this back and
// fails instead. (The unsafe direction -- indexing past the shared array -- is
// closed by the `vpb <= kMaxSharedCells` test in main(), not by this report.)
layout(set = 0, binding = 7, scalar) buffer DrawCommand {
  uint index_count;
  uint instance_count;
  uint first_index;
  int vertex_offset;
  uint first_instance;
  uint vertex_count;
  uint sharing_applied;
};
// The real index buffer -- a property of this dispatch, since a shared vertex is
// referenced by several triangles from several cells.
layout(set = 0, binding = 8, scalar) writeonly buffer Indices { uint indices[]; };

layout(push_constant, scalar) uniform PushConstants {
  int block_size;          // voxels per block edge
  int voxels_per_block;    // block_size^3
  float voxel_size;        // metres between adjacent voxels
  float iso;               // iso-value to extract
  uint num_active_blocks;  // active_blocks length
  uint capacity;           // max triangles the index run holds
  float weight_threshold;  // corners below this weight invalidate the cell
  uint has_color;          // 0 = no color input; vertices get opaque white
  uint vertex_capacity;    // max vertices the arena holds
  // The hash-table shape, for the on-device neighbour probe. Passed rather than
  // read from a VoxelGridParams block because hash_common.glsl's `pc` would
  // collide with this one -- see hash_lookup.glsl.
  int num_buckets;
  int bucket_size;
  int max_chain;
} pc;

// mcCornerShift / mcCellNormal / mcEdgeOwner / mcEdgeVertex + the near-tangent
// edge guard, over the Tables / Vertices / DrawCommand bindings declared above.
#include "marching_cubes_common.glsl"

// localIndex / mcLocalBase / s_neighbour / mcResolveNeighbourhood / mcGather.
#include "marching_cubes_sparse_common.glsl"

// The vertex this block emitted for each cell's three OWNED edges (+x, +y, +z
// from the cell's base corner), or one of the two sentinels below.
//
// Sized for block_size 8, the only shape any in-tree caller uses and the largest
// this can hold: a shared array needs a compile-time size while voxels_per_block
// is a push constant. MarchingCubes::extract REFUSES a larger block rather than
// letting it index past the end -- the library checks what the caller cannot see
// (the 2026-08-04 rule) -- and main() falls back to unshared as belt and braces,
// reporting through `sharing_applied` so the two constants cannot drift in
// silence.
const uint kMaxSharedCells = 512u;
// No vertex on this edge: it carries no crossing, or its owner cell is invalid,
// or the owner lies outside this block. A referencing cell duplicates.
const int kNoVertex = -1;
// There is deliberately no kVertexDropped any more. It existed because a
// per-vertex global atomic gave a dropped vertex no usable slot, so a
// referencing cell would claim a replacement and double-count -- reporting
// V_owned + ~3T instead of the true ~0.75T, MORE than not sharing at all, and
// the host would then refit a grow-only arena to that. Per-block reservation
// removes the failure at its source: the block counts first and reserves once,
// so every vertex has a deterministic slot whether or not it lands inside the
// arena, and the totals are exact by construction rather than by bookkeeping. A
// slot past `vertex_capacity` is simply not written, and the triangles that
// reference it decline to draw -- see mcTrianglePass.

// Per-block spans. The block counts its vertices and triangles, reserves ONE
// range of each with a single global atomicAdd, and only then writes -- so a
// block's output is contiguous in both buffers instead of interleaved with every
// other block in flight. That is what a per-block range can describe, and
// therefore the precondition for meshing only the blocks a fuse changed. The
// default kernel got this shape already; sharing needs TWO ranges because a
// shared vertex breaks `v = 3t`.
shared uint s_vtotal;   // vertices this block will create (owned + duplicated)
shared uint s_ttotal;   // triangles this block will emit
shared uint s_vbase;    // first vertex slot, from the global counter
shared uint s_ibase;    // first triangle slot, from the global counter
shared uint s_vcursor;  // hands out slots within [s_vbase, s_vbase + s_vtotal)
shared uint s_icursor;  // ... and within the triangle range
shared int s_edge_vtx[kMaxSharedCells * 3u];
// Phase 1's classification, so phase 2 can skip an empty or invalid cell
// without re-reading eight corners -- and, for a cell whose edges are all
// shared, without touching global memory at all. Bit 8 is "all corners valid";
// bits 0..7 are the cube index. Written on every path through phase 1, so it
// needs no separate zero-init pass.
shared uint s_case[kMaxSharedCells];
// mcEdgeOwner's answer for each of the 12 edges: (delta.xyz, axis). A pure
// function of the tables, identical for every cell and every block, so it is
// derived ONCE per workgroup by lanes 0..11 rather than by all 256 lanes and
// then again three times per triangle -- 96 SSBO loads per lane, at the 107k-block
// scale the neighbour-probe decision measured.
shared ivec4 s_edge_owner[12];
// The edge each axis owns (the one whose owner delta is zero) -- {0, 3, 8} under
// this numbering, derived rather than tabulated for the reason mcEdgeOwner is.
shared int s_owned_edge[3];

// Claim one vertex slot from the block's reserved range and write it, returning
// the index. Never fails: the range was sized by the count phase from the same
// tests the emit passes repeat, so a slot always exists.
//
// Past `vertex_capacity` the vertex is not written, but the slot is still
// consumed and still returned. `vertex_count` therefore ends as the field's true
// total whatever the arena holds -- the contract the host refits against -- and
// a triangle referencing an unwritten slot declines to draw, which
// mcTrianglePass decides by testing the range rather than by a sentinel.
int mcClaimVertex(vec3 position, vec3 normal, vec3 color) {
  // Within the block's reserved range, so the slot is inside
  // [s_vbase, s_vbase + s_vtotal) by construction -- the count phase sized that
  // range from the same tests this pass repeats.
  uint slot = s_vbase + atomicAdd(s_vcursor, 1u);
  if (slot < pc.vertex_capacity) {
    mcWriteVertex(slot, position, normal, color);
  }
  // Returned even when it lies past the arena: the slot is what a referencing
  // cell must NOT re-claim, and mcTrianglePass tests the range before drawing.
  return int(slot);
}

// Phase 1: classify the cell and emit a vertex on each of its three OWNED edges.
//
// Owned edges are the ones running +x/+y/+z from the cell's base corner, i.e.
// corner 0 to corners 1/3/4 under this repo's corner numbering (the prior
// engine's, ported verbatim). Every edge in the field is owned by exactly one
// cell, so after this pass every in-block edge that carries a crossing has a
// vertex, and phase 2 does no work for it but a lookup.
// PHASE ONE: classify the cell and count what it will produce -- nothing is
// written and nothing is interpolated.
//
// Counting needs only the cube index, which is why the ranges can be sized
// before a single vertex exists. `s_case` is filled here exactly as the old
// phase one filled it, so the emit passes below re-gather only the cells that
// actually produce something (~8% of them), not every cell.
void mcCountCell(BlockIndex block, int bs, uint local) {
  ivec3 base = mcLocalBase(local, bs);
  float sdf[8];
  vec3 corner_color[8];
  int cube_index;
  if (!mcGather(bs, base, sdf, corner_color, cube_index)) {
    s_case[local] = 0u;  // invalid: bit 8 clear
    return;
  }
  s_case[local] = uint(cube_index) | 0x100u;
  if (cube_index == 0 || cube_index == 255) {
    return;
  }

  // Vertices this cell OWNS: one per owned edge carrying a sign change.
  uint verts = 0u;
  for (int axis = 0; axis < 3; ++axis) {
    int edge = s_owned_edge[axis];
    bool inside_a = (cube_index & (1 << edge_to_vert[edge * 2 + 0])) != 0;
    bool inside_b = (cube_index & (1 << edge_to_vert[edge * 2 + 1])) != 0;
    if (inside_a != inside_b) {
      ++verts;
    }
  }

  uint tris = 0u;
  for (int e = 0; e < kMaxTrianglesPerCell * 3 &&
                  tri_table[cube_index * 16 + e] != -1;
       e += 3) {
    ++tris;
  }

  if (verts != 0u) {
    atomicAdd(s_vtotal, verts);
  }
  if (tris != 0u) {
    atomicAdd(s_ttotal, tris);
  }
}

// PHASE ONE-B: count the vertices this cell will DUPLICATE.
//
// Separate from mcCountCell, and it has to be: a duplicate is decided by the
// OWNER cell's state, which mcCountCell is still writing. Reading `s_case` in
// the same pass that fills it races, and the race is invisible on a fixture
// whose surface never meets an unintegrated voxel -- it under-reserves the
// block's range and the cursor then writes into the NEXT block's vertices.
//
// An edge is duplicated when its owner lies outside the block (the +face, where
// sharing would need the neighbouring workgroup) or when the owner cell is
// INVALID. The second is not an edge case: an owner reaches corners the
// referencing cell does not, so at the frontier of the integrated region it can
// fail its gather while its neighbour succeeds. A valid owner always agrees
// about the crossing, because both cells read the same two voxels for that edge,
// which is why validity alone decides it.
//
// Walked exactly as mcTrianglePass walks it, from the same table and the same
// tests, so the two cannot disagree about how many slots to reserve and how many
// to consume.
void mcCountDuplicates(int bs, uint local) {
  uint c = s_case[local];
  if ((c & 0x100u) == 0u) {
    return;
  }
  int cube_index = int(c & 0xFFu);
  if (cube_index == 0 || cube_index == 255) {
    return;
  }
  ivec3 base = mcLocalBase(local, bs);

  uint dupes = 0u;
  for (int e = 0; e < kMaxTrianglesPerCell * 3 &&
                  tri_table[cube_index * 16 + e] != -1;
       e += 3) {
    for (int k = 0; k < 3; ++k) {
      ivec3 owner = base + s_edge_owner[tri_table[cube_index * 16 + e + k]].xyz;
      if (!all(lessThan(owner, ivec3(bs)))) {
        ++dupes;  // owner outside the block
      } else {
        uint oi = uint(owner.x + bs * (owner.y + bs * owner.z));
        if ((s_case[oi] & 0x100u) == 0u) {
          ++dupes;  // owner inside but invalid -- it emitted no vertex
        }
      }
    }
  }
  if (dupes != 0u) {
    atomicAdd(s_vtotal, dupes);
  }
}

void mcOwnedEdgePass(BlockIndex block, int bs, uint local) {
  // Cleared here rather than in a separate pass: this function writes every
  // slot it does not clear, and it runs over exactly the cells this thread will
  // process in phase 2, so a preliminary zero-init loop needed a barrier that
  // synchronised nothing.
  s_edge_vtx[local * 3u + 0u] = kNoVertex;
  s_edge_vtx[local * 3u + 1u] = kNoVertex;
  s_edge_vtx[local * 3u + 2u] = kNoVertex;

  // Classified by mcCountCell, so an empty or invalid cell costs one shared read
  // and no gather at all -- which is most of them.
  uint c = s_case[local];
  if ((c & 0x100u) == 0u) {
    return;
  }
  int cube_index = int(c & 0xFFu);
  if (cube_index == 0 || cube_index == 255) {
    return;  // no crossing anywhere in this cell, so none on its owned edges
  }

  ivec3 base = mcLocalBase(local, bs);
  float sdf[8];
  vec3 corner_color[8];
  int regathered;
  if (!mcGather(bs, base, sdf, corner_color, regathered)) {
    return;  // cannot happen: mcCountCell already gathered this cell
  }
  ivec3 base_voxel = block.coord * bs + base;
  // One normal per cell, as before. A shared vertex therefore carries the
  // gradient of the cell that OWNS its edge rather than of each cell that draws
  // it -- the prior engine's behaviour, and the reason sharing changes vertex
  // normals even though it leaves every triangle where it was. A genuine
  // per-vertex normal (the gradient at the crossing) is a further change and is
  // deliberately not folded in here; it deserves its own measurement.
  // TODO(mesh): per-vertex normals now that vertices are shared.
  vec3 normal = mcCellNormal(sdf);
  for (int axis = 0; axis < 3; ++axis) {
    int edge = s_owned_edge[axis];
    int a = edge_to_vert[edge * 2 + 0];
    int b = edge_to_vert[edge * 2 + 1];
    // Sign change across this edge, read off the cube index we just built.
    bool inside_a = (cube_index & (1 << a)) != 0;
    bool inside_b = (cube_index & (1 << b)) != 0;
    if (inside_a == inside_b) {
      continue;
    }
    vec3 position;
    vec3 color;
    mcEdgeVertex(edge, sdf, corner_color, vec3(0.0), base_voxel, pc.voxel_size,
                 pc.iso, pc.has_color, position, color);
    // Always a real slot now, in range or not -- see mcClaimVertex.
    s_edge_vtx[local * 3u + uint(axis)] = mcClaimVertex(position, normal, color);
  }
}

// Phase 2: emit this cell's triangles as indices into the shared vertices.
//
// An edge whose owner cell lies inside this block is a lookup. One whose owner
// lies outside -- the block's +face, where sharing would need the neighbouring
// workgroup's shared memory -- is DUPLICATED: emitted inline from this cell's
// own corners. That is the accepted cost of in-block-only sharing, and it is
// why the win is ~4x rather than the ~6x full sharing would give.
void mcTrianglePass(BlockIndex block, int bs, uint local) {
  uint c = s_case[local];
  if ((c & 0x100u) == 0u) {
    return;  // phase 1 found an invalid corner
  }
  int cube_index = int(c & 0xFFu);
  if (cube_index == 0 || cube_index == 255) {
    return;
  }

  ivec3 base = mcLocalBase(local, bs);
  ivec3 base_voxel = block.coord * bs + base;
  // Gathered LAZILY: a cell all of whose edges are shared never touches global
  // memory here, which is most interior cells.
  float sdf[8];
  vec3 corner_color[8];
  vec3 normal = vec3(0.0, 0.0, 1.0);
  bool have_corners = false;

  // Triangles come from the block's reserved range, not from a per-triangle
  // global atomic, so this kernel's output is now per-block contiguous in BOTH
  // buffers -- which is what a dirty-only dispatch needs in order to leave a
  // clean block's geometry in place.
  //
  // `e` indexes TABLE ENTRIES, not triangles -- the row is walked three entries
  // at a time. mcWriteTriangle's `t` counts triangles and multiplies by three
  // itself, so passing this variable there would read three times too far along
  // the row and emit plausible, wrong geometry. Named apart for that reason.
  // Bounded by the row as well as its -1, for the reason kMaxTrianglesPerCell
  // is declared: the terminator is host-uploaded data, and this kernel has no
  // per-block span to fail safe against.
  for (int e = 0; e < kMaxTrianglesPerCell * 3 &&
                  tri_table[cube_index * 16 + e] != -1;
       e += 3) {
    // Resolve the three corners of this triangle to vertex indices first, then
    // claim the index slots -- so a triangle is counted exactly once whether or
    // not its vertices had to be duplicated.
    int vi[3];
    bool ok = true;
    for (int k = 0; k < 3; ++k) {
      int edge = tri_table[cube_index * 16 + e + k];
      ivec4 owner_info = s_edge_owner[edge];
      ivec3 owner = base + owner_info.xyz;
      int axis = owner_info.w;
      int slot = kNoVertex;
      if (all(lessThan(owner, ivec3(bs)))) {
        uint oi = uint(owner.x + bs * (owner.y + bs * owner.z));
        slot = s_edge_vtx[oi * 3u + uint(axis)];
      }
      if (slot == kNoVertex) {
        // Duplicate: this cell's own corners describe the same edge, and
        // mcEdgeVertex orders that edge's endpoints canonically, so the
        // position is bit-identical to what the owner would have produced.
        if (!have_corners) {
          int ignored;
          if (!mcGather(bs, base, sdf, corner_color, ignored)) {
            ok = false;
            break;
          }
          have_corners = true;
          normal = mcCellNormal(sdf);
        }
        vec3 position;
        vec3 color;
        mcEdgeVertex(edge, sdf, corner_color, vec3(0.0), base_voxel,
                     pc.voxel_size, pc.iso, pc.has_color, position, color);
        slot = mcClaimVertex(position, normal, color);
      }
      // Reserved but past the arena -- shared or duplicated, the vertex was
      // never written, so a triangle referencing it cannot be drawn. Counted
      // already, in the phase that sized the range.
      if (slot >= int(pc.vertex_capacity)) {
        ok = false;
      }
      vi[k] = slot;
    }
    uint tri = s_ibase + atomicAdd(s_icursor, 1u);
    uint first = tri * kIndicesPerTriangle;
    if (!ok || tri >= pc.capacity) {
      continue;  // dropped; the counters already carry it
    }
    // Reversed winding (0, 2, 1) so the CCW front face points along the outward
    // gradient, matching mcEmitCell and what gfx expects.
    indices[first + 0u] = uint(vi[0]);
    indices[first + 1u] = uint(vi[2]);
    indices[first + 2u] = uint(vi[1]);
  }
}

void main() {
  int bs = pc.block_size;
  uint vpb = uint(pc.voxels_per_block);
  // The workgroup's linear thread index, and its size. gl_LocalInvocationIndex
  // rather than gl_LocalInvocationID.x, and the full dimension product rather
  // than gl_WorkGroupSize.x, because the two agree only while local_size_y/z
  // are 1. That is true today (the emitted SPIR-V is `LocalSize 256 1 1`) and
  // nothing states it, so a later y/z dimension would silently race 8*Ny*Nz
  // writers onto the 8 s_neighbour slots and re-mesh every voxel Ny*Nz times
  // through the append atomic. Both forms compile; only this one stays correct.
  uint tid = gl_LocalInvocationIndex;
  uint group_threads =
      gl_WorkGroupSize.x * gl_WorkGroupSize.y * gl_WorkGroupSize.z;

  // One workgroup per block, NOT a flat voxel grid: shared memory is per
  // workgroup, so the neighbourhood and the owned-edge table can only be shared
  // if every thread here belongs to the same block.
  uint block_i = gl_WorkGroupID.x;
  if (block_i >= pc.num_active_blocks) {
    return;
  }
  BlockIndex block = active_blocks[block_i];

  // Belt and braces against a push constant that disagrees with the pipeline it
  // was built for: the host refuses a block this table could not index, and the
  // report tells it whether that refusal is still doing its job (see the
  // DrawCommand block).
  bool sharing = vpb <= kMaxSharedCells;
  if (block_i == 0u && tid == 0u) {
    sharing_applied = sharing ? 1u : 0u;
  }

  if (tid == 0u) {
    s_vtotal = 0u;
    s_ttotal = 0u;
    s_vbase = 0u;
    s_ibase = 0u;
    s_vcursor = 0u;
    s_icursor = 0u;
  }
  mcResolveNeighbourhood(block, tid);
  // Derived once per workgroup by the first 12 lanes, under the same barrier as
  // the neighbourhood: mcEdgeOwner is a pure function of the tables, so having
  // all 256 lanes run its 12-iteration, 96-load loop -- and then call it again
  // three times per triangle -- was that much redundant work per block.
  if (tid < 12u) {
    int e = int(tid);
    ivec3 delta;
    int axis;
    mcEdgeOwner(e, delta, axis);
    s_edge_owner[e] = ivec4(delta, axis);
    if (delta == ivec3(0)) {
      s_owned_edge[axis] = e;  // exactly one edge per axis, so no race
    }
  }
  barrier();

  // Stride over the block's voxels rather than assuming one thread each: the
  // workgroup is a fixed 256 while voxels_per_block is block_size^3 from the
  // grid params, so this is correct for any block size instead of only 8. See
  // the sibling kernel's note for the idle-lane and group-count costs below
  // block_size 8, which apply here unchanged.
  if (!sharing) {
    // Unreachable in practice -- the host refuses this grid before dispatching
    // -- so it meshes nothing rather than carrying a second emission path that
    // no test could reach. `sharing_applied` above is what turns it into a
    // clean host-side error.
    return;
  }

  // PHASE ONE -- classify every cell and size both ranges. Writes nothing.
  for (uint local = tid; local < vpb; local += group_threads) {
    mcCountCell(block, bs, local);
  }
  // Every cell's classification must be visible before any cell asks whether its
  // edge owners are valid.
  barrier();
  for (uint local = tid; local < vpb; local += group_threads) {
    mcCountDuplicates(bs, local);
  }
  barrier();

  // PHASE TWO -- one atomic per counter for the whole block.
  //
  // Both counters are bumped by the block's FULL totals whatever the arena
  // holds, so each still ends as the field's true total -- the contract the host
  // refits an undersized arena against. It is a stronger form of the old
  // count-but-drop: the totals are taken before any slot is, so an overflow can
  // no longer make either one a lower bound by abandoning a cell part-way.
  if (tid == 0u) {
    if (s_vtotal != 0u) {
      s_vbase = atomicAdd(vertex_count, s_vtotal);
    }
    if (s_ttotal != 0u) {
      s_ibase = atomicAdd(index_count, s_ttotal * kIndicesPerTriangle) /
                kIndicesPerTriangle;
    }
  }
  barrier();

  if (s_ttotal == 0u) {
    return;  // nothing reserved, nothing to write; uniform, and no barrier below
  }

  // PHASE THREE -- emit a vertex on every owned edge, into the reserved range.
  for (uint local = tid; local < vpb; local += group_threads) {
    mcOwnedEdgePass(block, bs, local);
  }
  // Every owned edge in this block must be resolved before any cell reads a
  // neighbour's slot -- this barrier is the whole of what makes sharing safe.
  barrier();

  // PHASE FOUR -- emit triangles as indices into those vertices.
  for (uint local = tid; local < vpb; local += group_threads) {
    mcTrianglePass(block, bs, local);
  }
}
