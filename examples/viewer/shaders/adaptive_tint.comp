// Paint one level's extracted vertices a single colour, so the window shows
// which resolution owns each surface. uv0 is left at the extractor's "no
// atlas" sentinel, so the hybrid pipeline draws this colour.

#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 256) in;

// Mirrors mesh::Vertex (64 bytes, scalar).
struct Vertex {
  vec3 position;
  vec3 normal;
  vec4 tangent;
  vec2 uv0;
  vec4 color;
};

layout(set = 0, binding = 0, scalar) buffer Vertices { Vertex vertices[]; };

layout(push_constant, scalar) uniform Push {
  vec4 color;
  uint count;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < pc.count) vertices[i].color = pc.color;
}
