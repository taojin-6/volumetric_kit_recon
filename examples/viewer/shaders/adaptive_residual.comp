// Where sampled depth points sit against one grid's iso-surface. A point's
// residual is its distance from that surface: the grid's trilinear TSDF at it
// divided by the TSDF's gradient length. Fused distances are measured along
// camera rays, which on a surface seen at angle t reads 1 / cos(t) too far;
// the gradient is steeper by the same factor, so the ratio is the distance
// along the normal, whatever the viewing angle. It is added to the cell of 2 x
// 2 x 2 voxels around the point's nearest node, so each cell keeps a count, a
// sum and a sum of squares (adaptive_bias.comp turns them into the surface's
// systematic offset there, with the sensor noise removed). Fixed point: the
// residual, clamped to 1 cm, in 0.02 mm units.
//
// Accum, per block slot: 64 cells of (count, sum, sum of squares).

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_scalar_block_layout : require

#define VR_HASH_ENTRIES_BINDING 1
#include "volumetric_kit/recon/volume/shaders/hash_lookup.glsl"

layout(local_size_x = 256) in;

layout(set = 0, binding = 0, scalar) readonly buffer Depth { float depth[]; };
layout(set = 0, binding = 2, scalar) readonly buffer Tsdf { float tsdf[]; };
layout(set = 0, binding = 3, scalar) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 4, scalar) buffer Accum { int accum[]; };

#include "adaptive_common.glsl"

layout(set = 0, binding = 5, scalar) readonly buffer Camera {
  AdaptiveCamera cam;
};

layout(push_constant, scalar) uniform Push {
  VoxelGridParams grid;
  uint stride;
  uint columns;
  uint count;
  float min_cos;  // 0 keeps every view angle
} pc;

int find(ivec3 b) {
  return vrFindBlockPtr(b, pc.grid.num_buckets, pc.grid.bucket_size,
                        pc.grid.max_chain);
}

// Trilinear TSDF at w and its gradient (per metre); false unless all eight
// nodes are observed. Node voxels sit at voxel * voxel_size; blocks are 8
// cubed.
bool sample_tsdf(vec3 w, out float r, out vec3 grad) {
  r = 0.0;
  grad = vec3(0.0);
  vec3 v = w / pc.grid.voxel_size;
  vec3 lo = floor(v);
  vec3 f = v - lo;
  ivec3 base = ivec3(lo);
  ivec3 cached = ivec3(0x7fffffff);
  int ptr = -1;
  for (int c = 0; c < 8; ++c) {
    ivec3 o = ivec3(c & 1, (c >> 1) & 1, c >> 2);
    ivec3 q = base + o;
    ivec3 b = q >> 3;  // floor division by 8, negative coordinates included
    if (b != cached) {
      cached = b;
      ptr = find(b);
    }
    if (ptr < 0) return false;
    ivec3 l = q - b * 8;
    uint i = uint(ptr) + uint(l.x + 8 * (l.y + 8 * l.z));
    if (!(weight[i] >= 1e-6)) return false;
    vec3 t = mix(vec3(1.0) - f, f, vec3(o));
    vec3 s = mix(vec3(-1.0), vec3(1.0), vec3(o));
    float d = tsdf[i];
    r += t.x * t.y * t.z * d;
    grad += vec3(s.x * t.y * t.z, t.x * s.y * t.z, t.x * t.y * s.z) * d;
  }
  grad /= pc.grid.voxel_size;
  return true;
}

void main() {
  uint id = gl_GlobalInvocationID.x;
  if (id >= pc.count) return;
  uint u = (id % pc.columns) * pc.stride;
  uint v = (id / pc.columns) * pc.stride;
  vec3 p;
  if (!unproject(cam, u, v, p)) return;
  if (pc.min_cos > 0.0) {
    vec3 right;
    vec3 down;
    if (!unproject(cam, u + 1u, v, right) || !unproject(cam, u, v + 1u, down)) {
      return;
    }
    vec3 n = cross(right - p, down - p);
    float denom = length(n) * length(p);
    if (!(denom > 0.0) || abs(dot(n, p)) < pc.min_cos * denom) return;
  }
  vec3 w = (cam.cam_to_world * vec4(p, 1.0)).xyz;
  float r;
  vec3 grad;
  if (!sample_tsdf(w, r, grad)) return;
  // A flat gradient is a truncated or unconverged field, not a surface.
  float slope = length(grad);
  if (!(slope > 0.3)) return;
  r /= slope;
  ivec3 node = ivec3(floor(w / pc.grid.voxel_size + 0.5));
  ivec3 b = node >> 3;
  int ptr = find(b);
  if (ptr < 0) return;
  ivec3 cell = (node - b * 8) >> 1;
  uint slot = uint(ptr) / uint(pc.grid.voxels_per_block);
  uint i = slot * 192u + uint(cell.x + 4 * (cell.y + 4 * cell.z)) * 3u;
  int q = int(round(clamp(r, -0.01, 0.01) / 2e-5));
  atomicAdd(accum[i], 1);
  atomicAdd(accum[i + 1u], q);
  atomicAdd(accum[i + 2u], q * q);
}
