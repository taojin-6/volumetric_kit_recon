@PACKAGE_INIT@

# recon_core links the platform threading runtime (std::mutex in the core's
# device, capture threads in the sensor tier) and header-only GLM (its public vector/matrix types), which the exported
# targets reference as Threads::Threads and the glm target -- re-find both here
# so the imported targets exist for consumers. Later tiers that take further
# public dependencies (e.g. a glTF writer in the mesh tier, or the CUDA runtime
# in the interop tier) add their re-find here too.
include(CMakeFindDependencyMacro)
# volumetric_kit_core is PUBLIC (Status / Result / the log sink, and its vulkan
# tier's Device / Allocator / Buffer, in every tier's signatures), at the minor
# version this package was built against. The prefix this package is installed
# in is the hint, as recon's install carries the core beside it;
# CMAKE_PREFIX_PATH still takes precedence.
find_dependency(volumetric_kit_core @VR_CORE_MAJOR_MINOR@ CONFIG HINTS
                "${PACKAGE_PREFIX_DIR}")
# A core found on CMAKE_PREFIX_PATH may predate the one recon builds with, or
# lack a required vulkan tier; then this package is not found, saying why, as a
# failed find_dependency leaves it. A camera-only package needs just the base.
if(@VR_PACKAGE_NEEDS_VULKAN@)
  vkc_require_core(@VR_CORE_MIN_VERSION@ VULKAN PACKAGE volumetric_kit_recon)
else()
  vkc_require_core(@VR_CORE_MIN_VERSION@ PACKAGE volumetric_kit_recon)
endif()
find_dependency(Threads)
# CONFIG mode, matching how the build finds glm (find_package(glm CONFIG)): glm
# ships a package config, not a CMake find module, so forcing CONFIG stops a
# stray Findglm.cmake on a consumer's module path from resolving to different
# (or missing) imported targets than the exported target expects.
find_dependency(glm CONFIG)
# recon_core reaches Vulkan through the core's core/vulkan/vulkan.hpp, so its
# public headers include <vulkan/vulkan.h> and the exported target carries
# Vulkan::Vulkan in its interface link set -- re-find it here so that imported
# target exists for consumers (without this, find_package(volumetric_kit_recon)
# followed by a link to recon_core fails with "Vulkan::Vulkan not found"). A
# package built with VR_CAMERA_ONLY has no recon_core and needs no Vulkan.
if(@VR_PACKAGE_NEEDS_VULKAN@)
  find_dependency(Vulkan)
endif()
# recon_sensor_orbbec, when this package was built with VR_WITH_ORBBEC, links
# the Orbbec SDK privately, but its link interface still names ob::OrbbecSDK,
# so the imported target must exist. The SDK the package was built against is
# the hint, so a consumer needs no SDK setting of its own; OrbbecSDK_ROOT
# points at another (cmake/vr_orbbec.cmake).
if(@VR_WITH_ORBBEC@)
  find_dependency(OrbbecSDK CONFIG PATH_SUFFIXES lib HINTS "@OrbbecSDK_DIR@")
endif()
# recon_sensor_video (VR_WITH_FFMPEG) likewise names PkgConfig::VR_FFMPEG,
# found through pkg-config and held to the FFmpeg the package was built
# against: its major versions, no older than its minors
# (cmake/vr_ffmpeg.cmake says why).
if(@VR_WITH_FFMPEG@)
  find_dependency(PkgConfig)
  pkg_check_modules(VR_FFMPEG QUIET IMPORTED_TARGET @VR_FFMPEG_CONSUMER_MODULES@)
  if(NOT VR_FFMPEG_FOUND)
    set(volumetric_kit_recon_FOUND FALSE)
    string(CONCAT volumetric_kit_recon_NOT_FOUND_MESSAGE
        "volumetric_kit_recon was built against FFmpeg libavcodec "
        "@VR_FFMPEG_libavcodec_VERSION@ and libavutil "
        "@VR_FFMPEG_libavutil_VERSION@; pkg-config finds no FFmpeg of those "
        "major versions at those versions or later. Point PKG_CONFIG_PATH at "
        "that FFmpeg.")
    return()
  endif()
endif()

# Static recon_io_assimp retains its private Assimp dependency as LINK_ONLY.
# Recreate that imported target before reading the shared export set: the
# Assimp the package was built against is the hint, and Assimp's own version
# rule holds a consumer to its major version, no older.
if(@VR_WITH_ASSIMP@)
  find_dependency(assimp @assimp_VERSION@ CONFIG HINTS "@assimp_DIR@")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_reconTargets.cmake")

# recon_core names the root its exported GLSL is included under, as in the build
# tree (src/volumetric_kit/recon/core/CMakeLists.txt): installed, the include
# directory. It is found from this file's directory, not from
# PACKAGE_PREFIX_DIR, which under CMake 3.29 and older a dependency's package
# config above resets (Ubuntu's Assimp gave /usr); and only here, past every
# return above, so a package not found leaves nothing in the caller's scope.
if(@VR_PACKAGE_NEEDS_VULKAN@)
  get_filename_component(_vr_glsl_root "@VR_SHADER_INCLUDE_FROM_CONFIG@"
                         ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}")
  set_target_properties(volumetric_kit::recon_core
                        PROPERTIES VR_SHADER_INCLUDE_DIR "${_vr_glsl_root}")
  unset(_vr_glsl_root)
endif()

check_required_components(volumetric_kit_recon)
