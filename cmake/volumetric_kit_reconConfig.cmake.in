@PACKAGE_INIT@

# recon_core links the platform threading runtime (std::mutex in the logging
# seam) and header-only GLM (its public vector/matrix types), which the exported
# targets reference as Threads::Threads and the glm target -- re-find both here
# so the imported targets exist for consumers. Later tiers that take further
# public dependencies (e.g. a glTF writer in the mesh tier, or the CUDA runtime
# in the interop tier) add their re-find here too.
include(CMakeFindDependencyMacro)
find_dependency(Threads)
# CONFIG mode, matching how the build finds glm (find_package(glm CONFIG)): glm
# ships a package config, not a CMake find module, so forcing CONFIG stops a
# stray Findglm.cmake on a consumer's module path from resolving to different
# (or missing) imported targets than the exported target expects.
find_dependency(glm CONFIG)
# recon_core reaches Vulkan through core/vulkan.hpp, so the public instance/
# device headers include <vulkan/vulkan.h> and the exported target carries
# Vulkan::Vulkan in its interface link set -- re-find it here so that imported
# target exists for consumers (without this, find_package(volumetric_kit_recon)
# followed by a link to recon_core fails with "Vulkan::Vulkan not found").
find_dependency(Vulkan)
# recon_sensor_orbbec, when this package was built with VR_WITH_ORBBEC, links
# the Orbbec SDK privately -- but a static build still names ob::OrbbecSDK in
# its link interface, and a shared one needs the SDK's library at link time, so
# the imported target must exist. Found the way the build found it
# (cmake/vr_orbbec.cmake): the SDK's package config sits in <sdk>/lib, a
# consumer may point at another SDK with OrbbecSDK_ROOT, and otherwise the one
# this package was built against is the hint -- so a consumer that never links
# the driver needs no SDK setting of its own. find_package cannot read the
# SDK's version file (named OrbbecSDKVersion.cmake), so the build's rule is
# repeated here: the release built against, or a newer one of its major.
if(@VR_WITH_ORBBEC@)
  find_dependency(OrbbecSDK CONFIG PATH_SUFFIXES lib HINTS "@OrbbecSDK_DIR@")
  file(STRINGS "${OrbbecSDK_DIR}/OrbbecSDKVersion.cmake" _vr_orbbec_version
       REGEX "^set\\(PACKAGE_VERSION \"[0-9.]+\"\\)")
  string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" _vr_orbbec_version
               "${_vr_orbbec_version}")
  string(REGEX MATCH "^[0-9]+" _vr_orbbec_major "${_vr_orbbec_version}")
  if(NOT _vr_orbbec_version
     OR _vr_orbbec_version VERSION_LESS "@VR_ORBBEC_SDK_VERSION@"
     OR NOT _vr_orbbec_major EQUAL "@VR_ORBBEC_SDK_VERSION_MAJOR@")
    string(CONCAT ${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
           "the Orbbec SDK at ${OrbbecSDK_DIR} is version "
           "'${_vr_orbbec_version}', but this package was built against "
           "@VR_ORBBEC_SDK_VERSION@ and needs it or a newer "
           "@VR_ORBBEC_SDK_VERSION_MAJOR@.x release; point OrbbecSDK_ROOT at "
           "one")
    set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
    return()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_reconTargets.cmake")

check_required_components(volumetric_kit_recon)
