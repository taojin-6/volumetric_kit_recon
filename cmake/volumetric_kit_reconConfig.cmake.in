@PACKAGE_INIT@

# The core tier is self-contained (backend-neutral, no external public deps), so
# there are no find_dependency() calls yet. Later tiers that take a public
# dependency (e.g. a glTF writer in the mesh tier, or the Metal/CUDA runtime in
# the interop tier) add their re-find here.
include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_reconTargets.cmake")

check_required_components(volumetric_kit_recon)
