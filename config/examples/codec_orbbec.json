{
  "version": 1,
  "operation": "fuse",
  "source": {
    "kind": "live",
    "sync_config": "../femto_mega_sync.json"
  },
  "run": {
    "frames": 600
  },
  "fusion": {
    "voxel_size_m": 0.01
